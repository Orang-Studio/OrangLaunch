<Window x:Class="OrangLauncher.MicrosoftLoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:wpf="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        mc:Ignorable="d"
        Title="Microsoft Login" Height="700" Width="500"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource BgPrimaryBrush}"
        Style="{DynamicResource DefaultWindowStyle}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <TextBlock Grid.Row="0" Text="Sign in with Microsoft" FontSize="18" FontWeight="Bold" 
                   Margin="20,15" Foreground="{DynamicResource FgPrimaryBrush}"/>
        <Grid Grid.Row="1" Margin="10">
            <wpf:WebView2 x:Name="LoginWebView" Visibility="Visible"/>
            <StackPanel x:Name="FallbackPanel" Visibility="Collapsed" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="20">
                <TextBlock Text="WebView2 is not available. Please use your browser to complete the login." 
                           TextWrapping="Wrap" Foreground="{DynamicResource FgPrimaryBrush}" Margin="0,0,0,15" TextAlignment="Center"/>
                <Button x:Name="OpenBrowserButton" Content="Open Browser" Padding="20,10" 
                        Style="{DynamicResource DefaultButtonStyle}" HorizontalAlignment="Center" Click="OpenBrowserButton_Click"/>

                <TextBlock Text="After logging in, paste the redirect URL here:" 
                           Foreground="{DynamicResource FgSecondaryBrush}" Margin="0,20,0,10" TextAlignment="Center"/>
                <TextBox x:Name="ClipboardUrlTextBox" Width="400" Margin="0,0,0,10" 
                         Style="{DynamicResource DefaultTextBoxStyle}"/>
                <Button x:Name="ProcessUrlButton" Content="Submit" Padding="20,10" 
                        Style="{DynamicResource DefaultButtonStyle}" HorizontalAlignment="Center" Click="ProcessUrlButton_Click"/>
            </StackPanel>
            <StackPanel x:Name="LoadingPanel" Visibility="Collapsed" VerticalAlignment="Center" HorizontalAlignment="Center">
                <TextBlock Text="Processing login..." FontSize="14" Foreground="{DynamicResource FgPrimaryBrush}" 
                           HorizontalAlignment="Center" Margin="0,0,0,15"/>
                <ProgressBar IsIndeterminate="True" Width="200" Height="4"/>
            </StackPanel>
        </Grid>
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,10,0,20">
            <Button Content="Cancel" Padding="30,10" Style="{DynamicResource DefaultButtonStyle}" Click="CancelButton_Click"/>
        </StackPanel>
    </Grid>
</Window>
