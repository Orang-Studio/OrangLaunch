<Window x:Class="OrangLauncher.DownloadWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:OrangLauncher"
        Title="Download Mods"
        Height="650" Width="900"
        MinHeight="500" MinWidth="700"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource BgPrimaryBrush}">
    <Window.Resources>
        <local:UrlToImageConverter x:Key="UrlToImageConverter"/>
    </Window.Resources>
    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid Grid.Row="0" Margin="0,0,0,15">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBox x:Name="SearchTextBox" Grid.Column="0" Height="36" 
                     Padding="12,6" FontSize="14"
                     KeyDown="SearchTextBox_KeyDown"
                     Background="{DynamicResource BgSecondaryBrush}"
                     Foreground="{DynamicResource FgPrimaryBrush}"
                     BorderBrush="{DynamicResource BorderPrimaryBrush}"/>
            <Button Grid.Column="1" Content="Search" Width="100" Height="36" Margin="10,0,0,0"
                    Click="SearchButton_Click"
                    Background="{DynamicResource AccentPrimaryBrush}"
                    Foreground="{DynamicResource FgPrimaryBrush}"/>
        </Grid>
        <ListBox x:Name="ResultsListBox" Grid.Row="1" 
                 Background="{DynamicResource BgSecondaryBrush}"
                 BorderBrush="{DynamicResource BorderPrimaryBrush}"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Grid Margin="10,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="60"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Width="48" Height="48" 
                                Background="{DynamicResource BgTertiaryBrush}" 
                                CornerRadius="6" Margin="0,0,12,0" ClipToBounds="True">
                            <Image Source="{Binding IconUrl, Converter={StaticResource UrlToImageConverter}}" 
                                   Stretch="UniformToFill" 
                                   RenderOptions.BitmapScalingMode="HighQuality"/>
                        </Border>

                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,15,0">
                            <TextBlock Text="{Binding Title}" FontWeight="Bold" FontSize="14"
                                       Foreground="{DynamicResource FgPrimaryBrush}"/>
                            <TextBlock Text="{Binding Description}" TextTrimming="CharacterEllipsis" 
                                       MaxWidth="450" FontSize="12"
                                       Foreground="{DynamicResource FgSecondaryBrush}"/>
                            <TextBlock Text="{Binding Author}" FontSize="11"
                                       Foreground="{DynamicResource FgTertiaryBrush}"/>
                        </StackPanel>

                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button Content="Details" Width="80" Height="28" Margin="0,0,8,0" Click="ViewDetailsButton_Click"
                                    Tag="{Binding}"
                                    Background="{DynamicResource BgTertiaryBrush}"
                                    Foreground="{DynamicResource FgPrimaryBrush}"/>
                            <Button Content="Install" Width="80" Height="28" Click="InstallProjectButton_Click"
                                    Tag="{Binding}"
                                    Background="{DynamicResource AccentPrimaryBrush}"
                                    Foreground="{DynamicResource FgPrimaryBrush}"/>
                        </StackPanel>
                    </Grid>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
        <ProgressBar x:Name="SearchProgressBar" Grid.Row="2" Height="4" Margin="0,10,0,0"
                     IsIndeterminate="False" Visibility="Collapsed"
                     Foreground="{DynamicResource AccentPrimaryBrush}"/>
    </Grid>
</Window>
