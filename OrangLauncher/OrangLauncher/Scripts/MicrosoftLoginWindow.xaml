<Window
    x:Class="OrangLauncher.MicrosoftLoginWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Microsoft Login">
    <Grid Background="{ThemeResource BgPrimaryBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <TextBlock Grid.Row="0" Text="Sign in with Microsoft" FontSize="18" FontWeight="Bold"
                   Margin="20,15" Foreground="{ThemeResource FgPrimaryBrush}"/>
        <Grid Grid.Row="1" Margin="10">
            <WebView2 x:Name="LoginWebView" Visibility="Visible"/>
            <StackPanel x:Name="FallbackPanel" Visibility="Collapsed" VerticalAlignment="Center"
                        HorizontalAlignment="Center" Margin="20">
                <TextBlock Text="WebView2 is not available. Please use your browser to complete the login."
                           TextWrapping="Wrap" Foreground="{ThemeResource FgPrimaryBrush}" Margin="0,0,0,15" TextAlignment="Center"/>
                <Button x:Name="OpenBrowserButton" Content="Open Browser" Padding="20,10"
                        HorizontalAlignment="Center" Click="OpenBrowserButton_Click"/>
                <TextBlock Text="After logging in, paste the redirect URL here:"
                           Foreground="{ThemeResource FgSecondaryBrush}" Margin="0,20,0,10" TextAlignment="Center"/>
                <TextBox x:Name="ClipboardUrlTextBox" Width="400" Margin="0,0,0,10"/>
                <Button x:Name="ProcessUrlButton" Content="Submit" Padding="20,10"
                        HorizontalAlignment="Center" Click="ProcessUrlButton_Click"/>
            </StackPanel>
            <StackPanel x:Name="LoadingPanel" Visibility="Collapsed" VerticalAlignment="Center" HorizontalAlignment="Center">
                <TextBlock Text="Processing login..." FontSize="14" Foreground="{ThemeResource FgPrimaryBrush}"
                           HorizontalAlignment="Center" Margin="0,0,0,15"/>
                <ProgressBar IsIndeterminate="True" Width="200" Height="4"/>
            </StackPanel>
        </Grid>
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,10,0,20">
            <Button Content="Cancel" Padding="30,10" Click="CancelButton_Click"/>
        </StackPanel>
    </Grid>
</Window>
