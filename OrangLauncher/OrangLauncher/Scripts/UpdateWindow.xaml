<Window
    x:Class="OrangLauncher.UpdateWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:OrangLauncher"
    Title="Check for Updates">
    <Grid Background="{ThemeResource BgPrimaryBrush}" Padding="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <TextBlock x:Name="TitleTextBlock" Grid.Row="0" Text="Available Updates"
                   FontSize="18" FontWeight="Bold" Margin="0,0,0,15"
                   Foreground="{ThemeResource FgPrimaryBrush}"/>
        <ListView x:Name="UpdatesListBox" Grid.Row="1" SelectionMode="None"
                  Background="{ThemeResource BgSecondaryBrush}">
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="local:UpdateItem">
                    <Grid Padding="8" ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <CheckBox Grid.Column="0" IsChecked="{x:Bind IsSelected, Mode=TwoWay}"
                                  VerticalAlignment="Center"/>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="{x:Bind Name}" FontWeight="SemiBold" FontSize="14"
                                       TextTrimming="CharacterEllipsis"/>
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <TextBlock Text="{x:Bind CurrentVersion}" FontSize="12" Opacity="0.5"/>
                                <TextBlock Text="→" FontSize="12" Opacity="0.5"/>
                                <TextBlock Text="{x:Bind LatestVersion}" FontSize="12" Foreground="{ThemeResource AccentPrimaryBrush}"/>
                            </StackPanel>
                        </StackPanel>
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,15,0,0" Spacing="10">
            <Button Content="Recheck" Width="90" Click="RecheckButton_Click"/>
            <Button Content="Remove Selected" Width="120" Click="RemoveSelectedButton_Click"/>
            <Button Content="Update Selected" Width="120" Click="UpdateSelectedButton_Click"/>
            <Button Content="Update All" Width="100" Click="UpdateAllButton_Click"/>
        </StackPanel>
        <ProgressBar x:Name="UpdateProgressBar" Grid.Row="3" Height="4" Margin="0,10,0,0"
                     IsIndeterminate="False" Visibility="Collapsed"/>
    </Grid>
</Window>
