QT_RUNNING_AS=Minecraft {version} ({loader}) darbojas kā {username}
QT_CHECKING_UPDATES=Pārbauda atjauninājumus...
QT_UPDATE_AUR_MSG=Jauna versija ({version}) pieejama caur AUR.\nVai vēlaties palaist 'yay -S oranglauncher-bin'?
