QT_ZINK_DESC=MESA_LOADER_DRIVER_OVERRIDE=zink. Helps on GPUs with weak OpenGL drivers, hurts on good ones.
QT_PRIME_DESC=DRI_PRIME=1, plus NVIDIA offload variables when the proprietary driver is present. For laptops with two GPUs.
QT_JVM_ARGS_HINT=Appended after the memory flags. One line or space separated, e.g. -XX:+UseG1GC -Dsome.prop=1
QT_ENV_VARS_HINT=One KEY=VALUE per line, lines starting with # are ignored.
QT_PRE_LAUNCH_HINT=Runs in the .minecraft folder before the game starts; a non-zero exit aborts the launch. $INST_NAME, $INST_DIR, $INST_MC_DIR, $INST_JAVA, $INST_MC_VER are set.
QT_WRAPPER_HINT=Prepended to the java command line, e.g. gamemoderun, mangohud, prime-run
QT_POST_EXIT_HINT=Runs after Minecraft closes. $INST_EXIT_CODE holds the exit code.
QT_RESOLUTION_INVALID=Width and height must both be positive numbers, e.g. 1920 x 1080.
QT_MEM_VIDEO_SAVED=Memory & video settings saved
QT_MP_VERSIONS_HINT=Pick a version and press Update. Mods from the old version are removed, your overrides and worlds stay.
QT_MP_NOT_FROM_PACK=This instance was not created from a modpack.\nImport an .mrpack or .orangpack below to link one.
QT_MP_NAME=Name: {name}
QT_MP_INSTALLED_VERSION=Installed version: {version}
QT_MP_FILE_COUNT=Files managed by the pack: {n}
QT_MP_IMPORTED=Imported: {date}
QT_MP_SUMMARY=Summary: {summary}
QT_MP_PROJECT=Modrinth project: {project}
QT_MP_NOT_LINKED=Not linked to a Modrinth project (imported from a local file).
QT_LOADING_VERSIONS=Loading versions...
QT_INSTALLED_TAG=installed
QT_MP_UPDATE_AVAILABLE=Update available: {version}
QT_MP_FETCH_FAIL=Could not fetch versions: {error}
QT_MP_PICK_FIRST=Check for updates first and pick a version from the list.
QT_MP_NO_FILE=That version has no downloadable file.
QT_UPDATE_MODPACK=Update modpack
QT_MP_UPDATE_CONFIRM=Update '{name}' to {version}?\n\nManaged mods from the current version are removed first, everything else stays.
QT_UPDATING_MODPACK=Updating modpack...
QT_REPAIR_TITLE=Repair
QT_REPAIR_CONFIRM=Re-download missing pack files using\n{path}?
QT_REPAIR_NO_SOURCE=The original pack file is gone and the instance is not linked to Modrinth.\nImport the pack file again to repair.
QT_UNLINK_TITLE=Unlink
QT_UNLINK_CONFIRM=Forget the modpack link? Files stay, only update tracking is removed.
QT_IMPORT_INTO_TITLE=Import modpack into this instance
QT_IMPORT_INTO_CONFIRM=Apply this pack on top of the current instance?\nManaged mods of the previously linked pack are removed first.
QT_EXPORT_NAME=Export {name}
QT_NOTHING_SELECTED=Nothing selected.
QT_EXPORTING=Exporting...
QT_EXPORTING_FILE=Exporting {name}
QT_EXPORTED_TO=Exported to:\n{path}
QT_EXPORT_FAILED=Export failed
QT_SELECT_SCREENSHOTS_FIRST=Click screenshots to select them first.
QT_COPIED_FILES_TO=Copied {n} file(s) to\n{path}
QT_DELETE_SCREENSHOTS=Delete screenshots
QT_DELETE_SCREENSHOTS_CONFIRM=Delete {n} screenshot(s)? This cannot be undone.
QT_LEGACY_FIXES_DESC=Adds the JVM flags old clients need (legacy merge sort, xrandr guard, macOS first-thread) and keeps Mojang's session endpoints reachable for skins on 1.7-1.16. Only affects versions below 1.13.
QT_ANTI_BAN_DESC=Removes Mojang's server block list provider from the game's classpath, so servers on the secret sessionserver.mojang.com/blockedservers list can still be joined. Works on 1.16.4 and newer. Turn it off if a server refuses the connection.
QT_DEMO_MODE=Launch the demo version (--demo)
QT_DEMO_MODE_DESC=Passes --demo to the game. Use this if you want to try the Java Edition demo: it starts the demo world with the 5 in-game day limit, no account purchase needed.
QT_BACKEND_X11=X11 / XWayland (compatible, default)
QT_BACKEND_WAYLAND=Wayland (native, needs LWJGL 3.3.3+)
QT_DISPLAY_BACKEND_HINT=Native Wayland needs LWJGL 3.3.3+ and a client that tolerates GLFW's missing window-icon support (recent versions, or a Wayland-fix mod on 1.20.1 and older); XWayland is the safe default.
QT_OTHER_SAVED=Other settings saved
QT_JAVA_RUNTIME_HINT=Automatic picks the Java version this Minecraft release needs (8, 17 or 21) and downloads it when missing.
QT_LWJGL_EXPLAIN=LWJGL is the library Minecraft uses to open its window, talk to the GPU and play sound. Minecraft ships its own copy; the old one bundled with 1.20.1 and earlier crashes on modern Linux desktops, so Automatic swaps in a newer one when needed.
QT_LWJGL_AUTO=Automatic (recommended) - fix old versions, keep new ones
QT_LWJGL_STOCK=Minecraft's own - never change anything
QT_LWJGL_PICK=Pick a specific version
QT_LWJGL_MODE=LWJGL mode
QT_LWJGL_VERSION=LWJGL version
QT_LWJGL_ADVANCED=Show advanced native library options
QT_CUSTOM_LWJGL_DIR=Custom LWJGL folder (overrides everything above)
QT_SELECT_LWJGL_FOLDER=Select LWJGL folder
QT_CUSTOM_LWJGL_DIR_HINT=Put the LWJGL jars (lwjgl, lwjgl-glfw, lwjgl-openal, ... plus their natives jars or the raw .so/.dll files) in one folder.
QT_NONE_DETECTED=none
QT_CUSTOM_GLFW=System GLFW library (.so / .dylib / .dll)
QT_SELECT_GLFW=Select GLFW library
QT_CUSTOM_GLFW_HINT=Empty = use the LWJGL one. Detected on this system: {path}
QT_CUSTOM_OPENAL=System OpenAL library (.so / .dylib / .dll)
QT_SELECT_OPENAL=Select OpenAL library
QT_CUSTOM_OPENAL_HINT=Empty = use the LWJGL one. Detected on this system: {path}
QT_SELECT_JAVA=Select the java executable
QT_JAVA_CUSTOM=Custom
QT_JAVA_AUTO=Automatic (recommended)
QT_JAVA_BROWSE=Choose a java executable...
QT_LWJGL_UNKNOWN=unknown (not installed yet)
QT_LWJGL_STATUS=Minecraft's own LWJGL: {stock}. Used at launch: {effective}.
QT_JAVA_REQUIRED=Java required: {major}
QT_NOTHING_INSTALLED=nothing installed yet (installs on first launch)
QT_LAUNCH_ID=Launch id: {id}
QT_VERSION_FOLDERS=Version folders: {folders}
QT_VERSIONS_SAVED=Versions saved
QT_REINSTALL_TITLE=Reinstall
QT_REINSTALL_CONFIRM=Delete the installed version folders (not mods, worlds or configs) so they are downloaded again on the next launch?
QT_REINSTALL_DONE=Version files removed, they will be reinstalled on launch
QT_FOR_VERSION=for {version}
QT_SEARCH_FAILED=Search failed: {error}
QT_NO_SKIN_PREVIEW=No skin preview available
QT_LANGUAGE_SAVED=Language preference saved. Restart the launcher to apply the change.
QT_MS_BROWSER_OPTION=Microsoft via browser
QT_MS_BROWSER_OPTION_TIP=Opens microsoft.com/link in your web browser with a one-time code already filled in; the launcher finishes the login by itself once you signed in there.
QT_MS_TWO_WAYS=Two ways to sign in: the embedded window logs you in inside the launcher; the browser option opens your default browser with a one-time code and the launcher picks the login up automatically.
QT_STATUS_BAR_DESC=Status text with the current instance and account.
QT_DEBUG_CRASH_HINT=Crashes are always written to crash_*.log in that folder, even with debug mode off.
QT_JAVA_RUNTIMES=Java runtimes
QT_JAVA_RUNTIMES_DESC=Install or update Java runtimes. The launcher checks pacman / apt first, then downloads directly from Adoptium if needed.
QT_WORKING=working
QT_LAUNCHER_NETWORK=Launcher network
QT_PROXY_LABEL=Proxy for the launcher only
QT_PROXY_HINT=Used for Modrinth, Mojang, Java and news downloads. Minecraft itself is launched without it. SOCKS needs the PySocks package.
QT_PROXY=Proxy
QT_PROXY_APPLIED=Proxy applied to launcher downloads.
QT_PROXY_CLEARED=Proxy cleared.
QT_PROXY_TESTING=Testing proxy...
QT_PROXY_APPLY=Apply proxy
QT_PROXY_TEST=Test proxy
QT_OPEN_WITH=Open with
QT_BROWSER_OVERRIDE=Browser command override (empty = system default)
QT_BROWSER_OVERRIDE_HINT=Example: firefox   or   flatpak run org.chromium.Chromium
QT_EDITOR_OVERRIDE=Text editor command override (empty = system default)
QT_EDITOR_OVERRIDE_HINT=Used for opening logs and config files. Example: kate   or   code --wait
QT_PICKER_NONE=none, the Qt dialog is used
QT_NATIVE_PICKER=Use the desktop's file picker
QT_NATIVE_PICKER_DESC=kdialog on Plasma, zenity elsewhere. Detected: {tool}
QT_DEBUG_INFO=Debug info
