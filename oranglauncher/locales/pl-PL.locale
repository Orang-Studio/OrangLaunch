QT_ALREADY_EXISTS={path} już istnieje.
QT_MOVE_INSTANCE=Przenieś profil
QT_MOVE_CONFIRM=Przenieść wszystkie pliki do\n{path}\ni zostawić dowiązanie symboliczne?
QT_MOVED_TO=Przeniesiono do {path}
QT_DEFAULT=domyślnie
QT_ZINK_DESC=MESA_LOADER_DRIVER_OVERRIDE=zink. Pomaga GPU ze słabymi sterownikami OpenGL, szkodzi dobrym.
QT_PRIME_DESC=DRI_PRIME=1 plus zmienne NVIDIA offload przy sterowniku własnościowym. Dla laptopów z dwoma GPU.
QT_JVM_ARGS_HINT=Dodawane po flagach pamięci. Jedna linia lub oddzielone spacjami, np. -XX:+UseG1GC -Dsome.prop=1
QT_ENV_VARS_HINT=Jedno KEY=VALUE na linię, linie zaczynające się od # są ignorowane.
QT_PRE_LAUNCH_HINT=Uruchamiane w folderze .minecraft przed startem gry; niezerowy kod wyjścia przerywa uruchamianie. Ustawione są $INST_NAME, $INST_DIR, $INST_MC_DIR, $INST_JAVA, $INST_MC_VER.
QT_WRAPPER_HINT=Dodawane przed poleceniem java, np. gamemoderun, mangohud, prime-run
QT_POST_EXIT_HINT=Uruchamiane po zamknięciu Minecrafta. $INST_EXIT_CODE zawiera kod wyjścia.
QT_RESOLUTION_INVALID=Szerokość i wysokość muszą być liczbami dodatnimi, np. 1920 x 1080.
QT_MEM_VIDEO_SAVED=Ustawienia pamięci i wideo zapisane
QT_MP_VERSIONS_HINT=Wybierz wersję i naciśnij Aktualizuj. Mody ze starej wersji są usuwane, Twoje zmiany i światy zostają.
QT_MP_NOT_FROM_PACK=Ten profil nie został utworzony z modpacka.\nZaimportuj poniżej .mrpack lub .orangpack, aby powiązać.
QT_MP_NAME=Nazwa: {name}
QT_MP_INSTALLED_VERSION=Zainstalowana wersja: {version}
QT_MP_FILE_COUNT=Plików zarządzanych przez paczkę: {n}
QT_MP_IMPORTED=Zaimportowano: {date}
QT_MP_SUMMARY=Opis: {summary}
QT_MP_PROJECT=Projekt Modrinth: {project}
QT_MP_NOT_LINKED=Niepowiązana z projektem Modrinth (zaimportowana z lokalnego pliku).
QT_LOADING_VERSIONS=Ładowanie wersji...
QT_INSTALLED_TAG=zainstalowana
QT_MP_UPDATE_AVAILABLE=Dostępna aktualizacja: {version}
QT_MP_FETCH_FAIL=Nie udało się pobrać wersji: {error}
QT_MP_PICK_FIRST=Najpierw sprawdź aktualizacje i wybierz wersję z listy.
QT_MP_NO_FILE=Ta wersja nie ma pliku do pobrania.
QT_UPDATE_MODPACK=Aktualizuj modpack
QT_MP_UPDATE_CONFIRM=Zaktualizować '{name}' do {version}?\n\nNajpierw usuwane są zarządzane mody bieżącej wersji, reszta zostaje.
QT_UPDATING_MODPACK=Aktualizowanie modpacka...
QT_REPAIR_TITLE=Napraw
QT_REPAIR_CONFIRM=Pobrać ponownie brakujące pliki paczki używając\n{path}?
QT_REPAIR_NO_SOURCE=Brakuje oryginalnego pliku paczki, a profil nie jest powiązany z Modrinth.\nZaimportuj plik paczki ponownie, aby naprawić.
QT_UNLINK_TITLE=Odłącz
QT_UNLINK_CONFIRM=Zapomnieć powiązanie z modpackiem? Pliki zostają, usuwane jest tylko śledzenie aktualizacji.
QT_IMPORT_INTO_TITLE=Importuj modpack do tego profilu
QT_IMPORT_INTO_CONFIRM=Nałożyć tę paczkę na bieżący profil?\nNajpierw zostaną usunięte mody zarządzane przez poprzednio powiązaną paczkę.
QT_EXPORT_NAME=Eksportuj {name}
QT_NOTHING_SELECTED=Nic nie wybrano.
QT_EXPORTING=Eksportowanie...
QT_EXPORTING_FILE=Eksportowanie {name}
QT_EXPORTED_TO=Wyeksportowano do:\n{path}
QT_EXPORT_FAILED=Eksport nie powiódł się
QT_SELECT_SCREENSHOTS_FIRST=Najpierw kliknij zrzuty ekranu, aby je wybrać.
QT_COPIED_FILES_TO=Skopiowano plików: {n} do\n{path}
QT_DELETE_SCREENSHOTS=Usuń zrzuty ekranu
QT_DELETE_SCREENSHOTS_CONFIRM=Usunąć zrzutów ekranu: {n}? Tej operacji nie można cofnąć.
QT_LEGACY_FIXES_DESC=Dodaje flagi JVM potrzebne starym klientom (legacy merge sort, zabezpieczenie xrandr, macOS first-thread) i utrzymuje dostęp do serwerów sesji Mojang dla skinów w 1.7-1.16. Dotyczy tylko wersji poniżej 1.13.
QT_ANTI_BAN_DESC=Usuwa dostawcę listy zablokowanych serwerów Mojang z classpath gry, dzięki czemu można nadal dołączać do serwerów z tajnej listy sessionserver.mojang.com/blockedservers. Działa na 1.16.4 i nowszych. Wyłącz, jeśli serwer odrzuca połączenie.
QT_DEMO_MODE=Uruchamiaj wersję demo (--demo)
QT_DEMO_MODE_DESC=Przekazuje --demo do gry. Użyj, jeśli chcesz wypróbować demo Java Edition: uruchamia świat demo z limitem 5 dni w grze, bez zakupu konta.
QT_BACKEND_X11=X11 / XWayland (kompatybilne, domyślne)
QT_BACKEND_WAYLAND=Wayland (natywny, wymaga LWJGL 3.3.3+)
QT_DISPLAY_BACKEND_HINT=Natywny Wayland wymaga LWJGL 3.3.3+ i klienta tolerującego brak obsługi ikony okna w GLFW (nowe wersje lub mod Wayland-fix dla 1.20.1 i starszych); XWayland to bezpieczne ustawienie domyślne.
QT_OTHER_SAVED=Pozostałe ustawienia zapisane
QT_JAVA_RUNTIME_HINT=Automatycznie wybiera wersję Javy potrzebną tej wersji Minecrafta (8, 17 lub 21) i pobiera ją, gdy jej brakuje.
QT_LWJGL_EXPLAIN=LWJGL to biblioteka, której Minecraft używa do otwierania okna, komunikacji z GPU i odtwarzania dźwięku. Minecraft ma własną kopię; stara, dołączona do 1.20.1 i starszych, wywala się na nowoczesnych pulpitach Linuksa, więc Automatycznie w razie potrzeby podmienia ją na nowszą.
QT_LWJGL_AUTO=Automatycznie (zalecane) - naprawia stare wersje, nowych nie rusza
QT_LWJGL_STOCK=Własna Minecrafta - niczego nie zmieniaj
QT_LWJGL_PICK=Wybierz konkretną wersję
QT_LWJGL_MODE=Tryb LWJGL
QT_LWJGL_VERSION=Wersja LWJGL
QT_LWJGL_ADVANCED=Pokaż zaawansowane opcje bibliotek natywnych
QT_CUSTOM_LWJGL_DIR=Własny folder LWJGL (nadpisuje wszystko powyżej)
QT_SELECT_LWJGL_FOLDER=Wybierz folder LWJGL
QT_CUSTOM_LWJGL_DIR_HINT=Umieść pliki jar LWJGL (lwjgl, lwjgl-glfw, lwjgl-openal, ... plus ich natives jar lub surowe pliki .so/.dll) w jednym folderze.
QT_NONE_DETECTED=brak
QT_CUSTOM_GLFW=Systemowa biblioteka GLFW (.so / .dylib / .dll)
QT_SELECT_GLFW=Wybierz bibliotekę GLFW
QT_CUSTOM_GLFW_HINT=Puste = użyj tej z LWJGL. Wykryto w systemie: {path}
QT_CUSTOM_OPENAL=Systemowa biblioteka OpenAL (.so / .dylib / .dll)
QT_SELECT_OPENAL=Wybierz bibliotekę OpenAL
QT_CUSTOM_OPENAL_HINT=Puste = użyj tej z LWJGL. Wykryto w systemie: {path}
QT_SELECT_JAVA=Wybierz plik wykonywalny java
QT_JAVA_CUSTOM=Własna
QT_JAVA_AUTO=Automatycznie (zalecane)
QT_JAVA_BROWSE=Wybierz plik wykonywalny java...
QT_LWJGL_UNKNOWN=nieznana (jeszcze nie zainstalowano)
QT_LWJGL_STATUS=Własna LWJGL Minecrafta: {stock}. Używana przy starcie: {effective}.
QT_JAVA_REQUIRED=Wymagana Java: {major}
QT_NOTHING_INSTALLED=jeszcze nic nie zainstalowano (instaluje się przy pierwszym uruchomieniu)
QT_LAUNCH_ID=Id uruchomienia: {id}
QT_VERSION_FOLDERS=Foldery wersji: {folders}
QT_VERSIONS_SAVED=Wersje zapisane
QT_REINSTALL_TITLE=Zainstaluj ponownie
QT_REINSTALL_CONFIRM=Usunąć foldery zainstalowanych wersji (nie mody, światy ani konfiguracje), aby zostały pobrane ponownie przy następnym uruchomieniu?
QT_REINSTALL_DONE=Pliki wersji usunięte, zostaną zainstalowane ponownie przy uruchomieniu
QT_FOR_VERSION=dla {version}
QT_SEARCH_FAILED=Wyszukiwanie nie powiodło się: {error}
QT_NO_SKIN_PREVIEW=Podgląd skina niedostępny
QT_LANGUAGE_SAVED=Preferencja języka zapisana. Uruchom launcher ponownie, aby zastosować zmianę.
QT_MS_BROWSER_OPTION=Microsoft przez przeglądarkę
QT_MS_BROWSER_OPTION_TIP=Otwiera microsoft.com/link w przeglądarce z już wpisanym jednorazowym kodem; po zalogowaniu launcher sam dokończy logowanie.
QT_MS_TWO_WAYS=Dwa sposoby logowania: wbudowane okno loguje Cię wewnątrz launchera; opcja z przeglądarką otwiera domyślną przeglądarkę z jednorazowym kodem, a launcher automatycznie przejmuje logowanie.
QT_STATUS_BAR_DESC=Tekst statusu z bieżącym profilem i kontem.
QT_DEBUG_CRASH_HINT=Awarie są zawsze zapisywane do crash_*.log w tym folderze, nawet przy wyłączonym trybie debugowania.
QT_JAVA_RUNTIMES=Środowiska Java
QT_JAVA_RUNTIMES_DESC=Zainstaluj lub zaktualizuj środowiska Java. Launcher najpierw sprawdza pacman / apt, a w razie potrzeby pobiera bezpośrednio z Adoptium.
QT_WORKING=w toku
QT_LAUNCHER_NETWORK=Sieć launchera
QT_PROXY_LABEL=Proxy tylko dla launchera
QT_PROXY_HINT=Używane do pobierania z Modrinth, Mojang, Javy i wiadomości. Sam Minecraft uruchamia się bez niego. SOCKS wymaga pakietu PySocks.
QT_PROXY=Proxy
QT_PROXY_APPLIED=Proxy zastosowane do pobierania launchera.
QT_PROXY_CLEARED=Proxy wyczyszczone.
QT_PROXY_TESTING=Testowanie proxy...
QT_PROXY_APPLY=Zastosuj proxy
QT_PROXY_TEST=Testuj proxy
QT_OPEN_WITH=Otwieraj za pomocą
QT_BROWSER_OVERRIDE=Nadpisanie polecenia przeglądarki (puste = domyślna systemowa)
QT_BROWSER_OVERRIDE_HINT=Przykład: firefox   lub   flatpak run org.chromium.Chromium
QT_EDITOR_OVERRIDE=Nadpisanie polecenia edytora tekstu (puste = domyślny systemowy)
QT_EDITOR_OVERRIDE_HINT=Używane do otwierania logów i plików konfiguracyjnych. Przykład: kate   lub   code --wait
QT_PICKER_NONE=brak, używane jest okno Qt
QT_NATIVE_PICKER=Używaj systemowego okna wyboru plików
QT_NATIVE_PICKER_DESC=kdialog w Plasmie, zenity gdzie indziej. Wykryto: {tool}
QT_DEBUG_INFO=Informacje debugowania
QT_COPY=Kopiuj
QT_SOURCE_PACKAGE=Pakiet budowany ze źródeł
QT_SOURCE_PACKAGE_DESC=Istnieje pakiet AUR oranglauncher, który buduje launcher przez Nuitkę na Twoim komputerze zamiast dostarczać gotowy plik binarny. Wolisz kompilować sam? Zainstaluj ten. Chcesz szybki gotowy? Zostań przy oranglauncher-bin.
QT_VIEW_ON_AUR=Zobacz na AUR
QT_PLUGINS_RELOADED=Wtyczki zostały przeładowane.
QT_PLUGINS_RELOAD_FAIL=Błąd przeładowania wtyczek: {error}
QT_WELCOME_TITLE=Witaj w OrangLauncher
QT_WIZ_ACCOUNT_DESC=Zaloguj się przez Microsoft lub użyj nazwy offline
QT_WIZ_JAVA_DESC=Wybierz środowisko Java (auto działa dobrze)
QT_WIZ_PROFILE_DESC=Utwórz pierwszy profil albo pobierz modpack
QT_WIZ_SETTINGS_DESC=Kilka zalecanych przełączników
QT_CREATE_INSTANCE_FAIL=Nie udało się utworzyć profilu:\n{error}
QT_LATEST_CRASH_REPORT=Najnowszy raport awarii: {name}
QT_DID_YOU_MEAN=Czy chodziło o: {options}?
QT_UNKNOWN_VERSION=Nieznana wersja
QT_UNKNOWN_VERSION_MSG='{version}' nie jest poprawną wersją Minecrafta.
QT_LOGO_TOOLTIP=OrangLauncher
QT_MS_SIGNING_IN=Logowanie przez Microsoft...
QT_ACCOUNT_ADDED=Dodano konto {name}
QT_NO_ACCOUNT_TITLE=Nie dodano konta
QT_NO_ACCOUNT_MSG=Nie dodano jeszcze żadnego konta.\n\nNaciśnij 'Nowy profil' pod polem konta i wybierz:\n  - Microsoft: zaloguj się kontem, do którego należy Minecraft\n  - Offline: wybierz nazwę użytkownika (tylko tryb jednoosobowy i serwery offline)\n\nKontami można też zarządzać w Ustawienia > Konta.
QT_NO_INSTANCE_MSG=Nie ma jeszcze profilu do gry.\n\nOtwórz zakładkę Profile gry i naciśnij Nowy, aby utworzyć, albo użyj Importuj, aby dodać modpack (.mrpack / .orangpack / .zip).
QT_VERSION_ERROR=Błąd wersji
QT_VERSION_ERROR_MSG=Wybrany profil nie ma ustawionej wersji Minecrafta. Edytuj profil i ustaw poprawną wersję.
QT_LAUNCHING=Uruchamianie {version} ({loader})...
QT_RUNNING_AS=Minecraft {version} ({loader}) działa jako {username}
QT_CHECKING_UPDATES=Sprawdzanie aktualizacji...
QT_UPDATE_AUR_MSG=Nowa wersja ({version}) jest dostępna przez AUR.\nUruchomić 'yay -S oranglauncher-bin'?
QT_UPDATE_MSG=Dostępna jest nowa wersja ({version})!\n\nInformacje o wydaniu:\n{notes}\n\nZaktualizować teraz?
QT_UPDATE_AVAILABLE_TITLE=Dostępna aktualizacja
QT_NO_UPDATES=Brak aktualizacji
QT_LATEST_VERSION=Używasz najnowszej wersji ({version}).
QT_UPDATES=Aktualizacje
MODS_BACKUP_NONE=Brak kopii zapasowych
MODS_BACKUP_NONE_MSG=Nie znaleziono plików kopii zapasowych .bak.
MODS_BACKUP_RESTORE_TITLE=Przywróć kopie zapasowe
MODS_BACKUP_RESTORE_CONFIRM=Przywrócić kopii zapasowych: {count}?
MODS_BACKUP_RESTORE_DONE=Przywracanie zakończone
QT_MS_DEVICE_STEPS=W przeglądarce otwarto microsoft.com/link z już wpisanym kodem. Zaloguj się tam i wróć - launcher sam dokończy logowanie, nie trzeba nic kopiować.
QT_MS_DEVICE_WAITING=Oczekiwanie na zalogowanie...
QT_MS_DEVICE_STILL_WAITING=Nadal czekam. Jeśli po zalogowaniu przeglądarka trafiła na account.microsoft.com (tak dzieje się zawsze przy logowaniu przez GitHub / Google), kliknij „Otwórz przeglądarkę ponownie” - za drugim razem Microsoft od razu pokaże potwierdzenie Minecrafta.
QT_COPY_CODE=Kopiuj kod
QT_MS_DEVICE_HINT=Jeśli przeglądarka się nie otworzyła, wejdź samodzielnie na https://www.microsoft.com/link i wpisz kod.
QT_MS_DEVICE_REQUESTING=Pobieranie kodu logowania...
QT_MS_DEVICE_FAIL=Nie udało się rozpocząć logowania przez przeglądarkę: {error}
QT_FILTER_VERSION=Wersja gry
QT_FILTER_LOADER=Loader
QT_FILTER_CATEGORY=Kategoria
QT_FILTER_ANY=Dowolna
QT_FILTER_INSTANCE=Instancja ({value})
QT_CHOOSE_VERSION=Wybierz wersję...
QT_VERSION_PICKER_TITLE={title} - wersje
QT_VERSION_PICKER_LOADING=Ładowanie wersji...
QT_VERSION_PICKER_EMPTY=Żadna wersja nie pasuje do bieżących filtrów.
QT_VERSION_PICKER_COUNT={count} wersji - najnowsze najpierw
QT_VERSION_RECOMMENDED=Zalecana
QT_AUDIO_UNAVAILABLE=Odtwarzanie dźwięku niedostępne (brak QtMultimedia).