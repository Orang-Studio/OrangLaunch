<Window x:Class="OrangLauncher.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:OrangLauncher"
        xmlns:olcontrols="clr-namespace:OrangLauncher.Controls"
        xmlns:wpf="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        mc:Ignorable="d"
        Title="OrangLauncher" Height="820" Width="1280" MinWidth="1280"
        WindowStartupLocation="CenterScreen"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
    Background="{DynamicResource BgPrimaryBrush}"
    Style="{DynamicResource DefaultWindowStyle}">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Other/themes/Icons.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <local:FileNameConverter x:Key="FileNameConverter"/>
            <local:InstanceIconConverter x:Key="InstanceIconConverter"/>
            <local:Base64ImageConverter x:Key="Base64ImageConverter"/>
            <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
            <Style TargetType="{x:Type ContextMenu}">
                <Setter Property="Background" Value="{DynamicResource BgSecondaryBrush}"/>
                <Setter Property="Foreground" Value="{DynamicResource FgPrimaryBrush}"/>
                <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="HasDropShadow" Value="True"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="{x:Type ContextMenu}">
                            <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="4" Padding="2">
                                <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Cycle"/>
                            </Border>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style TargetType="{x:Type MenuItem}">
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="Foreground" Value="{DynamicResource FgPrimaryBrush}"/>
                <Setter Property="Padding" Value="8,6"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="{x:Type MenuItem}">
                            <Border x:Name="Bd" Background="{TemplateBinding Background}" 
                                    Padding="{TemplateBinding Padding}" CornerRadius="2">
                                <ContentPresenter ContentSource="Header" 
                                                  HorizontalAlignment="Left" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsHighlighted" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="{DynamicResource BgHoverBrush}"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </ResourceDictionary>
    </Window.Resources>
    <Grid SnapsToDevicePixels="True">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <TabControl x:Name="MainTabControl" Grid.Row="0" Margin="10"
                    Style="{DynamicResource DefaultTabControlStyle}"
                    ItemContainerStyle="{DynamicResource DefaultTabItemStyle}"
                    SnapsToDevicePixels="True">
            <TabItem>
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal">
                        <Rectangle Width="16" Height="16" Margin="0,0,8,0" VerticalAlignment="Center" HorizontalAlignment="Center" Fill="{DynamicResource FgPrimaryBrush}">
                            <Rectangle.OpacityMask>
                                <ImageBrush ImageSource="pack://siteoforigin:,,,/Other/images/icons/news.png" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality"/>
                            </Rectangle.OpacityMask>
                        </Rectangle>
                        <TextBlock Text="{Binding LocalizedUpdateNotes}"/>
                    </StackPanel>
                </TabItem.Header>
                <Grid Background="{DynamicResource BgPrimaryBrush}">
                    <wpf:WebView2 x:Name="NewsWebView" Source="https://oranges.lt/launcher.html" Margin="5"/>
                    <WebBrowser x:Name="NewsWebBrowser" Margin="5" Visibility="Collapsed" Focusable="False"/>
                    <Grid x:Name="NewsNativePanel" Margin="5" Visibility="Collapsed" Background="{DynamicResource BgPrimaryBrush}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <TextBlock x:Name="NewsNativeTitle" Grid.Row="0" Text="Update Notes" FontSize="20" FontWeight="Bold"
                                   Margin="10,10,10,4" Foreground="{DynamicResource FgPrimaryBrush}"/>
                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="10,0,10,0">
                            <StackPanel x:Name="NewsNativeStack"/>
                        </ScrollViewer>
                        <TextBlock Grid.Row="2" Margin="10,6,10,10">
                            <Hyperlink Click="NewsNativeBrowserLink_Click">
                                <TextBlock x:Name="NewsNativeBrowserText" Text="Open news in browser"/>
                            </Hyperlink>
                        </TextBlock>
                    </Grid>
                </Grid>
            </TabItem>
            <TabItem>
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal">
                        <Rectangle Width="16" Height="16" Margin="0,0,8,0" VerticalAlignment="Center" HorizontalAlignment="Center" Fill="{DynamicResource FgPrimaryBrush}">
                            <Rectangle.OpacityMask>
                                <ImageBrush ImageSource="pack://siteoforigin:,,,/Other/images/icons/logs.png" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality"/>
                            </Rectangle.OpacityMask>
                        </Rectangle>
                        <TextBlock Text="{Binding LocalizedLauncherLog}"/>
                    </StackPanel>
                </TabItem.Header>
                <Grid Background="{DynamicResource BgPrimaryBrush}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <TextBox x:Name="LogTextBox" Grid.Row="0" IsReadOnly="True" 
                           VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                           FontFamily="Consolas" FontSize="10" Margin="10"
                           Style="{DynamicResource DefaultTextBoxStyle}"/>
                    <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="10,5,10,10">
                        <Button x:Name="CopyLogButton" Padding="10,5" Margin="0,0,8,0"
                              Style="{DynamicResource DefaultButtonStyle}" Click="CopyLogButton_Click">
                            <StackPanel Orientation="Horizontal">
                                <Rectangle Width="14" Height="14" Margin="0,0,8,0" VerticalAlignment="Center" HorizontalAlignment="Center" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Control}}">
                                    <Rectangle.OpacityMask>
                                        <ImageBrush ImageSource="pack://siteoforigin:,,,/Other/images/icons/dublicate.png" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality"/>
                                    </Rectangle.OpacityMask>
                                </Rectangle>
                                <TextBlock x:Name="CopyLogText" Text="Copy Log"/>
                            </StackPanel>
                        </Button>
                        <Button x:Name="ExportLogButton" Padding="10,5" Margin="0,0,8,0"
                              Style="{DynamicResource DefaultButtonStyle}" Click="ExportLogButton_Click">
                            <StackPanel Orientation="Horizontal">
                                <Rectangle Width="14" Height="14" Margin="0,0,8,0" VerticalAlignment="Center" HorizontalAlignment="Center" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Control}}">
                                    <Rectangle.OpacityMask>
                                        <ImageBrush ImageSource="pack://siteoforigin:,,,/Other/images/icons/update.png" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality"/>
                                    </Rectangle.OpacityMask>
                                </Rectangle>
                                <TextBlock x:Name="ExportLogText" Text="Export to mclo.gs"/>
                            </StackPanel>
                        </Button>
                        <Button x:Name="ClearLogButton" Padding="10,5"
                              Style="{DynamicResource DefaultButtonStyle}" Click="ClearLogButton_Click">
                            <StackPanel Orientation="Horizontal">
                                <Rectangle Width="14" Height="14" Margin="0,0,8,0" VerticalAlignment="Center" HorizontalAlignment="Center" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Control}}">
                                    <Rectangle.OpacityMask>
                                        <ImageBrush ImageSource="pack://siteoforigin:,,,/Other/images/icons/delete.png" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality"/>
                                    </Rectangle.OpacityMask>
                                </Rectangle>
                                <TextBlock Text="{Binding LocalizedClearLog, RelativeSource={RelativeSource AncestorType=Window}}"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>

                </Grid>
            </TabItem>
            <TabItem>
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal">
                        <Rectangle Width="16" Height="16" Margin="0,0,8,0" VerticalAlignment="Center" HorizontalAlignment="Center" Fill="{DynamicResource FgPrimaryBrush}">
                            <Rectangle.OpacityMask>
                                <ImageBrush ImageSource="pack://siteoforigin:,,,/Other/images/icons/instances.png" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality"/>
                            </Rectangle.OpacityMask>
                        </Rectangle>
                        <TextBlock Text="{Binding LocalizedGameProfiles}"/>
                    </StackPanel>
                </TabItem.Header>
                <Grid Margin="10" Background="{DynamicResource BgPrimaryBrush}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Grid x:Name="GameProfilesListView" Grid.RowSpan="2" Background="{DynamicResource BgPrimaryBrush}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <WrapPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10" VerticalAlignment="Center">
                            <TextBlock Text="{Binding LocalizedGameProfilesTitle}" FontSize="20" FontWeight="Bold" 
                                     VerticalAlignment="Center" Foreground="{DynamicResource FgPrimaryBrush}" Margin="0,0,20,5"/>

                            <Button x:Name="AddProfileButton" Margin="0,0,10,5" Padding="15,6" 
                                  Style="{DynamicResource DefaultButtonStyle}" Click="AddProfileButton_Click">
                                <StackPanel Orientation="Horizontal">
                                    <Rectangle Width="14" Height="14" Margin="0,0,8,0" VerticalAlignment="Center" HorizontalAlignment="Center" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Control}}">
                                        <Rectangle.OpacityMask>
                                            <ImageBrush ImageSource="pack://siteoforigin:,,,/Other/images/icons/newprofile.png" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality"/>
                                        </Rectangle.OpacityMask>
                                    </Rectangle>
                                    <TextBlock Text="{Binding LocalizedNewProfile}"/>
                                </StackPanel>
                            </Button>
                            <Button x:Name="ImportModpackButton" Margin="0,0,10,5" Padding="15,6" 
                                  Style="{DynamicResource DefaultButtonStyle}" Click="ImportModpackButton_Click">
                                <StackPanel Orientation="Horizontal">
                                    <Rectangle Width="14" Height="14" Margin="0,0,8,0" VerticalAlignment="Center" HorizontalAlignment="Center" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Control}}">
                                        <Rectangle.OpacityMask>
                                            <ImageBrush ImageSource="pack://siteoforigin:,,,/Other/images/icons/mrpack.png" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality"/>
                                        </Rectangle.OpacityMask>
                                    </Rectangle>
                                    <TextBlock Text="{Binding LocalizedImportMrpack, RelativeSource={RelativeSource AncestorType=Window}}"/>
                                </StackPanel>
                            </Button>
                        </WrapPanel>
                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <ItemsControl x:Name="ProfilesItemsControl" ItemsSource="{Binding GameInstances}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel Orientation="Horizontal" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Width="280" Height="90" Margin="0,0,15,15" Background="{DynamicResource BgSecondaryBrush}" 
                                                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="4" Padding="10">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <Image Grid.Column="0" Source="{Binding Path=., Converter={StaticResource InstanceIconConverter}}" 
                                                       Width="64" Height="64" Margin="0,0,12,0" VerticalAlignment="Center"
                                                       RenderOptions.BitmapScalingMode="HighQuality"/>
                                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Name}" FontWeight="Bold" FontSize="14" 
                                                             Foreground="{DynamicResource FgPrimaryBrush}" TextTrimming="CharacterEllipsis"
                                                             Margin="0,0,0,4"/>
                                                    <TextBlock Text="{Binding Version}" FontSize="12" Foreground="{DynamicResource FgSecondaryBrush}" Margin="0,0,0,2"/>
                                                    <TextBlock Text="{Binding ModLoader}" FontSize="11" Foreground="{DynamicResource FgTertiaryBrush}"/>
                                                </StackPanel>
                                                <Button Grid.Column="2" Padding="6" Width="28" Height="28" VerticalAlignment="Center"
                                                        Style="{DynamicResource DefaultButtonStyle}" Background="Transparent" BorderThickness="0"
                                                        Click="InstanceContextMenu_Click" Tag="{Binding}">
                                                    <Rectangle Width="16" Height="16" VerticalAlignment="Center" HorizontalAlignment="Center" Fill="{DynamicResource FgSecondaryBrush}">
                                                        <Rectangle.OpacityMask>
                                                            <ImageBrush ImageSource="pack://siteoforigin:,,,/Other/images/icons/settings.png" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality"/>
                                                        </Rectangle.OpacityMask>
                                                    </Rectangle>
                                                    <Button.ContextMenu>
                                                        <ContextMenu>
                                                            <MenuItem Header="Select" Click="SelectInstance_Click" Tag="{Binding PlacementTarget.Tag, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                                                            <MenuItem Header="Edit" Click="EditInstance_Click" Tag="{Binding PlacementTarget.Tag, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                                                            <MenuItem Header="Duplicate" Click="DuplicateInstance_Click" Tag="{Binding PlacementTarget.Tag, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                                                            <MenuItem Header="Open Folder" Click="OpenInstanceFolder_Click" Tag="{Binding PlacementTarget.Tag, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                                                            <Separator Background="{DynamicResource BorderBrush}"/>
                                                            <MenuItem Header="Delete" Click="DeleteInstance_Click" Tag="{Binding PlacementTarget.Tag, RelativeSource={RelativeSource AncestorType=ContextMenu}}" Foreground="#FF5555"/>
                                                        </ContextMenu>
                                                    </Button.ContextMenu>
                                                </Button>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Grid>
                    <Grid x:Name="GameProfilesEditView" Grid.RowSpan="2" Background="{DynamicResource BgPrimaryBrush}" Visibility="Collapsed">
                        <Grid>
                            <Border Background="{DynamicResource BgSecondaryBrush}" CornerRadius="10" Padding="30" 
                                    VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="600" MinWidth="450">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <!-- Uses the shared IconButtonStyle and the real close icon, matching
                                         the Cancel button below; it previously used a style that only
                                         existed in one theme (falling back to unstyled system chrome
                                         everywhere else) and faked the X by rotating the "add" icon. -->
                                    <Button Grid.Row="0" HorizontalAlignment="Right" VerticalAlignment="Top"
                                            Style="{DynamicResource IconButtonStyle}" Click="CancelProfileButton_Click"
                                            Width="32" Height="32" Margin="0,-5,-5,0">
                                        <Rectangle Width="14" Height="14" VerticalAlignment="Center" HorizontalAlignment="Center"
                                                   Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}">
                                            <Rectangle.OpacityMask>
                                                <ImageBrush ImageSource="pack://siteoforigin:,,,/Other/images/icons/close.png" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality"/>
                                            </Rectangle.OpacityMask>
                                        </Rectangle>
                                    </Button>
                                    <StackPanel Grid.Row="1" HorizontalAlignment="Center" Margin="0,0,0,20">
                                        <Button x:Name="InstanceIconButton" Width="64" Height="64" Background="Transparent" BorderThickness="0" Click="InstanceIconButton_Click" Cursor="Hand">
                                            <Grid>
                                                <Image x:Name="InstanceIconImage" Width="48" Height="48" RenderOptions.BitmapScalingMode="HighQuality"/>
                                                <Rectangle Width="14" Height="14" Margin="0,0,5,5" VerticalAlignment="Bottom" HorizontalAlignment="Right" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Control}}">
                                                    <Rectangle.OpacityMask>
                                                        <ImageBrush ImageSource="pack://siteoforigin:,,,/Other/images/icons/edit.png" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality"/>
                                                    </Rectangle.OpacityMask>
                                                </Rectangle>
                                            </Grid>
                                        </Button>
                                        <TextBlock x:Name="EditProfileTitle" Text="{Binding LocalizedCreateProfile, RelativeSource={RelativeSource AncestorType=Window}}" FontSize="20" FontWeight="Bold" 
                                                 Foreground="{DynamicResource FgPrimaryBrush}" HorizontalAlignment="Center" Margin="0,10,0,0"/>
                                    </StackPanel>
                                    <ScrollViewer Grid.Row="2" MaxHeight="400" VerticalScrollBarVisibility="Auto">
                                        <StackPanel Margin="0,0,10,0">
                                            <Label Content="{Binding LocalizedName, RelativeSource={RelativeSource AncestorType=Window}}" Foreground="{DynamicResource FgPrimaryBrush}" Margin="0,0,0,5"/>
                                            <TextBox x:Name="ProfileNameTextBox" Style="{DynamicResource DefaultTextBoxStyle}" Margin="0,0,0,15"/>

                                            <Grid Margin="0,0,0,15">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="10"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Grid.Column="0">
                                                    <Label Content="{Binding LocalizedModLoader, RelativeSource={RelativeSource AncestorType=Window}}" Foreground="{DynamicResource FgPrimaryBrush}" Margin="0,0,0,5"/>
                                                    <ComboBox x:Name="ProfileModLoaderComboBox" Style="{DynamicResource DefaultComboBoxStyle}"
                                                              SelectionChanged="ProfileModLoaderComboBox_SelectionChanged">
                                                        <ComboBoxItem Content="Vanilla" Tag="vanilla"/>
                                                        <ComboBoxItem Content="Forge" Tag="forge"/>
                                                        <ComboBoxItem Content="Fabric" Tag="fabric"/>
                                                        <ComboBoxItem Content="Quilt" Tag="quilt"/>
                                                        <ComboBoxItem Content="NeoForge" Tag="neoforge"/>
                                                        <ComboBoxItem Content="OptiFine" Tag="optifine"/>
                                                    </ComboBox>
                                                </StackPanel>
                                                <StackPanel Grid.Column="2">
                                                    <Label Content="{Binding LocalizedLoaderVersion, RelativeSource={RelativeSource AncestorType=Window}}" Foreground="{DynamicResource FgPrimaryBrush}" Margin="0,0,0,5"/>
                                                    <ComboBox x:Name="ProfileModLoaderVersionComboBox" Style="{DynamicResource DefaultComboBoxStyle}" IsEditable="True"/>
                                                </StackPanel>
                                            </Grid>
                                            <Label Content="{Binding LocalizedVersion, RelativeSource={RelativeSource AncestorType=Window}}" Foreground="{DynamicResource FgPrimaryBrush}" Margin="0,0,0,5"/>
                                            <ComboBox x:Name="ProfileVersionComboBox" Style="{DynamicResource DefaultComboBoxStyle}" Margin="0,0,0,15" SelectionChanged="ProfileVersionComboBox_SelectionChanged"/>

                                            <Label Content="{Binding LocalizedRam, RelativeSource={RelativeSource AncestorType=Window}}" Foreground="{DynamicResource FgPrimaryBrush}" Margin="0,0,0,5"/>
                                            <StackPanel Orientation="Horizontal" Margin="0,0,0,15">
                                                <TextBlock Text="{Binding Value, ElementName=ProfileRamSlider, StringFormat={}{0:F0} MB}" 
                                                           Foreground="{DynamicResource FgPrimaryBrush}" Width="60" VerticalAlignment="Center"/>
                                                <Slider x:Name="ProfileRamSlider" Width="300" Minimum="1024" Maximum="32768" TickFrequency="1024" 
                                                        IsSnapToTickEnabled="True" SmallChange="512" LargeChange="1024" VerticalAlignment="Center"/>
                                            </StackPanel>
                                            <Label Content="{Binding LocalizedPerformance, RelativeSource={RelativeSource AncestorType=Window}}" Foreground="{DynamicResource FgPrimaryBrush}" Margin="0,0,0,5"/>
                                            <ComboBox x:Name="ProfilePerformanceTierComboBox" Style="{DynamicResource DefaultComboBoxStyle}" Margin="0,0,0,15">
                                                <ComboBoxItem Content="Auto (Detect)" Tag="Auto" IsSelected="True"/>
                                                <ComboBoxItem Content="Low (Conservative)" Tag="Low"/>
                                                <ComboBoxItem Content="Mid (Balanced)" Tag="Mid"/>
                                                <ComboBoxItem Content="High (Aggressive)" Tag="High"/>
                                            </ComboBox>
                                            <Label Content="{Binding LocalizedJavaVersion, RelativeSource={RelativeSource AncestorType=Window}}" Foreground="{DynamicResource FgPrimaryBrush}" Margin="0,0,0,5"/>
                                            <ComboBox x:Name="ProfileJavaComboBox" Style="{DynamicResource DefaultComboBoxStyle}" Margin="0,0,0,15"/>
                                            <Label Content="{Binding LocalizedJavaArgs, RelativeSource={RelativeSource AncestorType=Window}}" Foreground="{DynamicResource FgPrimaryBrush}" Margin="0,0,0,5"/>
                                            <TextBox x:Name="ProfileJavaArgsTextBox" Style="{DynamicResource DefaultTextBoxStyle}" Margin="0,0,0,10"/>
                                        </StackPanel>
                                    </ScrollViewer>
                                    <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,20,0,0">
                                        <Button x:Name="SaveProfileButton" Margin="0,0,10,0" Padding="30,8" 
                                              Style="{DynamicResource DefaultButtonStyle}" Click="SaveProfileButton_Click">
                                            <StackPanel Orientation="Horizontal">
                                                <Rectangle Width="14" Height="14" Margin="0,0,8,0" VerticalAlignment="Center" HorizontalAlignment="Center" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Control}}">
                                                    <Rectangle.OpacityMask>
                                                        <ImageBrush ImageSource="pack://siteoforigin:,,,/Other/images/icons/check.png" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality"/>
                                                    </Rectangle.OpacityMask>
                                                </Rectangle>
                                                <TextBlock Text="{Binding LocalizedSave, RelativeSource={RelativeSource AncestorType=Window}}"/>
                                            </StackPanel>
                                        </Button>
                                        <Button Padding="30,8" Style="{DynamicResource DefaultButtonStyle}" 
                                              Click="CancelProfileButton_Click">
                                            <StackPanel Orientation="Horizontal">
                                                <Rectangle Width="14" Height="14" Margin="0,0,8,0" VerticalAlignment="Center" HorizontalAlignment="Center" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Control}}">
                                                    <Rectangle.OpacityMask>
                                                        <ImageBrush ImageSource="pack://siteoforigin:,,,/Other/images/icons/close.png" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality"/>
                                                    </Rectangle.OpacityMask>
                                                </Rectangle>
                                                <TextBlock Text="{Binding LocalizedCancel, RelativeSource={RelativeSource AncestorType=Window}}"/>
                                            </StackPanel>
                                        </Button>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </Grid>
                    </Grid>
                </Grid>
            </TabItem>
            <TabItem>
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal">
                        <Rectangle Width="16" Height="16" Margin="0,0,8,0" VerticalAlignment="Center" HorizontalAlignment="Center" Fill="{DynamicResource FgPrimaryBrush}">
                            <Rectangle.OpacityMask>
                                <ImageBrush ImageSource="pack://siteoforigin:,,,/Other/images/icons/resourcepacks.png" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality"/>
                                </Rectangle.OpacityMask>
                            </Rectangle>
                            <TextBlock Text="{Binding LocalizedResourcePacks}"/>
                        </StackPanel>
                    </TabItem.Header>
                    <TabControl x:Name="ResourcePacksTabControl" Style="{DynamicResource DefaultTabControlStyle}" ItemContainerStyle="{DynamicResource DefaultTabItemStyle}" SelectionChanged="ResourcePacksTabControl_SelectionChanged" Background="{DynamicResource BgPrimaryBrush}">
                        <TabItem>
                            <TabItem.Header>
                                <StackPanel Orientation="Horizontal">
                                    <Rectangle Width="16" Height="16" Margin="0,0,8,0" VerticalAlignment="Center" HorizontalAlignment="Center" Fill="{DynamicResource FgPrimaryBrush}">
                                        <Rectangle.OpacityMask>
                                            <ImageBrush ImageSource="pack://siteoforigin:,,,/Other/images/icons/resourcepacks.png" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality"/>
                                        </Rectangle.OpacityMask>
                                    </Rectangle>
                                    <TextBlock Text="{Binding LocalizedResourcePacksTab, RelativeSource={RelativeSource AncestorType=Window}}"/>
                                </StackPanel>
                            </TabItem.Header>
                            <Grid Margin="10" Background="{DynamicResource BgPrimaryBrush}">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <StackPanel Grid.Row="0" Margin="0,0,0,10">
                                    <Grid Margin="0,0,0,10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{Binding LocalizedSearch, RelativeSource={RelativeSource AncestorType=Window}}" VerticalAlignment="Center" Margin="0,0,10,0" Foreground="{DynamicResource FgPrimaryBrush}"/>
                                        <TextBox Grid.Column="1" x:Name="ResourcePacksSearchTextBox" MinWidth="250" MaxWidth="500" HorizontalAlignment="Stretch" Style="{DynamicResource DefaultTextBoxStyle}" TextChanged="ResourcePacksSearchTextBox_TextChanged"/>
                                    </Grid>
                                    <WrapPanel Orientation="Horizontal">
                                        <Button x:Name="RefreshResourcePacksButton" Margin="0,0,10,5" Padding="10,5" 
                                          Style="{DynamicResource DefaultButtonStyle}" Click="RefreshResourcePacksButton_Click">
                                            <StackPanel Orientation="Horizontal">
                                                <Rectangle Width="14" Height="14" Margin="0,0,8,0" VerticalAlignment="Center" HorizontalAlignment="Center" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Control}}">
                                                    <Rectangle.OpacityMask>
                                                        <ImageBrush ImageSource="pack://siteoforigin:,,,/Other/images/icons/refresh.png" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality"/>
                                                    </Rectangle.OpacityMask>
                                                </Rectangle>
                                                <TextBlock Text="{Binding LocalizedRefresh, RelativeSource={RelativeSource AncestorType=Window}}"/>
                                            </StackPanel>
                                        </Button>
                                        <Button x:Name="AddResourcePackButton" Margin="0,0,10,5" Padding="10,5" 
                                          Style="{DynamicResource DefaultButtonStyle}" Click="AddResourcePackButton_Click">
                                            <StackPanel Orientation="Horizontal">
                                                <Rectangle Width="14" Height="14" Margin="0,0,8,0" VerticalAlignment="Center" HorizontalAlignment="Center" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Control}}">
                                                    <Rectangle.OpacityMask>
