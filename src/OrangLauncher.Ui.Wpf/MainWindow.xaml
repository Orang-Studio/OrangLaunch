                                                <Rectangle Width="16" Height="16" Margin="0,0,8,0" VerticalAlignment="Center" HorizontalAlignment="Center" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Control}}">
                                                    <Rectangle.OpacityMask>
                                                        <ImageBrush ImageSource="pack://siteoforigin:,,,/Other/images/icons/game.png" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality"/>
                                                    </Rectangle.OpacityMask>
                                                </Rectangle>
                                                <TextBlock Text="{Binding LocalizedJavaInstallation}" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource FgPrimaryBrush}"/>
                                            </StackPanel>
                                            <TextBlock Text="{Binding LocalizedJavaInstallationDesc}"
                                                     FontSize="12" Foreground="{DynamicResource FgSecondaryBrush}" Margin="0,0,0,15" TextWrapping="Wrap"/>
                                            <CheckBox x:Name="JavaArchitectureCheckBox" Content="Use 32-bit (x86) Java instead of 64-bit"
                                                      Margin="0,0,0,4"/>
                                            <TextBlock Text="For compatibility with older systems or graphics drivers. 32-bit builds are only available for Java 8 and 17 - other versions fall back to 64-bit automatically."
                                                     FontSize="12" Foreground="{DynamicResource FgSecondaryBrush}" TextWrapping="Wrap" Margin="0,0,0,15"/>
                                            <ItemsControl x:Name="JavaVersionsItemsControl">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Border Background="{DynamicResource BgSecondaryBrush}" CornerRadius="4" Padding="12,8" Margin="0,0,0,8">
                                                            <Grid>
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="*"/>
                                                                    <ColumnDefinition Width="Auto"/>
                                                                    <ColumnDefinition Width="Auto"/>
                                                                </Grid.ColumnDefinitions>
                                                                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                                                    <TextBlock Text="{Binding Label}" FontWeight="Bold" FontSize="13" Foreground="{DynamicResource FgPrimaryBrush}"/>
                                                                    <TextBlock Text="{Binding Status}" FontSize="11" Foreground="{DynamicResource FgSecondaryBrush}" Margin="0,2,0,0"/>
                                                                </StackPanel>
                                                                <Button Grid.Column="1" Content="{Binding InstallButtonText}" Padding="12,5" Margin="8,0,0,0"
                                                                        Style="{DynamicResource DefaultButtonStyle}" Click="InstallJavaButton_Click" Tag="{Binding Version}"
                                                                        Visibility="{Binding ShowInstall, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                                                <Button Grid.Column="2" Content="{Binding UninstallButtonText}" Padding="12,5" Margin="8,0,0,0"
                                                                        Style="{DynamicResource DefaultButtonStyle}" Click="UninstallJavaButton_Click" Tag="{Binding Version}"
                                                                        Visibility="{Binding ShowUninstall, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                                            </Grid>
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                                <StackPanel x:Name="AboutSettingsPanel" Visibility="Collapsed">

                                    <Border Background="Transparent" CornerRadius="5" Padding="15">
                                        <StackPanel>
                                            <Image Source="pack://siteoforigin:,,,/Other/images/orange.png" Width="64" Height="64" HorizontalAlignment="Center" Margin="0,0,0,15"/>
                                            <TextBlock Text="OrangLauncher" FontSize="18" FontWeight="Bold" Margin="0,0,0,10" Foreground="{DynamicResource FgPrimaryBrush}" HorizontalAlignment="Center"/>
                                            <TextBlock Text="Version: 6.0.0" FontSize="12" Margin="0,0,0,5" Foreground="{DynamicResource FgPrimaryBrush}" HorizontalAlignment="Center"/>
                                            <TextBlock Text="{Binding LocalizedAboutDesc}" 
                                                     FontSize="12" Foreground="{DynamicResource FgSecondaryBrush}" Margin="0,0,0,20" TextWrapping="Wrap" HorizontalAlignment="Center" TextAlignment="Center"/>
                                            <TextBlock Text="{Binding LocalizedDevelopedBy}" FontSize="12" Margin="0,0,0,15" Foreground="{DynamicResource FgPrimaryBrush}" HorizontalAlignment="Center"/>
                                            <WrapPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                                <Button x:Name="CheckUpdatesButton" Style="{DynamicResource DefaultButtonStyle}" Height="35" MinWidth="160" Padding="15,8" Margin="0,0,10,5">
                                                    <StackPanel Orientation="Horizontal">
                                                        <Rectangle Width="14" Height="14" Margin="0,0,8,0" VerticalAlignment="Center" HorizontalAlignment="Center" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Control}}">
                                                            <Rectangle.OpacityMask>
                                                                <ImageBrush ImageSource="pack://siteoforigin:,,,/Other/images/icons/update.png" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality"/>
                                                            </Rectangle.OpacityMask>
                                                        </Rectangle>
                                                        <TextBlock Text="{Binding LocalizedCheckForUpdates, RelativeSource={RelativeSource AncestorType=Window}}"/>
                                                    </StackPanel>
                                                </Button>
                                                <Button x:Name="OpenGitHubButton" Style="{DynamicResource DefaultButtonStyle}" Height="35" MinWidth="160" Padding="15,8" Margin="0,0,0,5">
                                                    <StackPanel Orientation="Horizontal">
                                                        <Rectangle Width="14" Height="14" Margin="0,0,8,0" VerticalAlignment="Center" HorizontalAlignment="Center" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Control}}">
                                                            <Rectangle.OpacityMask>
                                                                <ImageBrush ImageSource="pack://siteoforigin:,,,/Other/images/icons/github.png" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality"/>
                                                            </Rectangle.OpacityMask>
                                                        </Rectangle>
                                                        <TextBlock Text="{Binding LocalizedViewOnGitHub, RelativeSource={RelativeSource AncestorType=Window}}"/>
                                                    </StackPanel>
                                                </Button>
                                            </WrapPanel>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>
                </Grid>
            </TabItem>
        </TabControl>
        <Border Grid.Row="2" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0" Background="{DynamicResource BgSecondaryBrush}" SnapsToDevicePixels="True">
            <Grid Margin="10" SnapsToDevicePixels="True">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Orientation="Vertical" VerticalAlignment="Center">
                    <Label Content="{Binding LocalizedProfile}" Style="{DynamicResource HeaderLabelStyle}"/>
                    <ComboBox x:Name="ProfileComboBox" Width="200" Margin="0,5,0,0" 
                            SelectedIndex="0" Style="{DynamicResource DefaultComboBoxStyle}">
                        <ComboBoxItem Content="Loading profiles..."/>
                    </ComboBox>
                    <Button x:Name="ManageAccountsButton" Content="{Binding LocalizedManageAccounts}" Margin="0,5,0,0" 
                          Padding="10,5" Style="{DynamicResource DefaultButtonStyle}" Click="ManageAccountsButton_Click"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Vertical" HorizontalAlignment="Center" 
                          VerticalAlignment="Center">
                    <Label x:Name="GameProfileTitleLabel" Content="{Binding LocalizedGameProfilesTitle}" 
                         Style="{DynamicResource HeaderLabelStyle}" HorizontalAlignment="Center"/>
                    <Label x:Name="GameProfileInfoLabel" Content="No profile selected" 
                         HorizontalAlignment="Center" Margin="0,5,0,10" Foreground="{DynamicResource FgSecondaryBrush}"/>
                    <Button x:Name="PlayButton" Content="{Binding LocalizedPlay}" 
                          Style="{DynamicResource PlayButtonStyle}" HorizontalAlignment="Center" Height="56" Width="217" Click="PlayButton_Click"/>
                </StackPanel>
                <StackPanel Grid.Column="2" Orientation="Vertical" VerticalAlignment="Center" 
                          HorizontalAlignment="Right">
                    <ComboBox x:Name="GameProfileComboBox" Width="250" Margin="0,0,0,5" 
                            SelectedIndex="0" Style="{DynamicResource DefaultComboBoxStyle}">
                        <ComboBoxItem Content="Loading game profiles..."/>
                    </ComboBox>
                    <Label x:Name="StatusLabel" Content="{Binding StatusText}" 
                         Style="{DynamicResource NewsLabelStyle}" HorizontalAlignment="Right"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>