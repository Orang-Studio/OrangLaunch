<Window x:Class="OrangLauncher.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:OrangLauncher"
        xmlns:olcontrols="clr-namespace:OrangLauncher.Controls"
        xmlns:wpf="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        mc:Ignorable="d"
        Title="OrangLauncher" Height="820" Width="1280" MinWidth="1280"
        WindowStartupLocation="CenterScreen"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
    Background="{DynamicResource BgPrimaryBrush}"
    Style="{DynamicResource DefaultWindowStyle}">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Styles/themes/Icons.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <local:FileNameConverter x:Key="FileNameConverter"/>
            <local:InstanceIconConverter x:Key="InstanceIconConverter"/>
            <local:Base64ImageConverter x:Key="Base64ImageConverter"/>
            <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
            <Style TargetType="{x:Type ContextMenu}">
                <Setter Property="Background" Value="{DynamicResource BgSecondaryBrush}"/>
                <Setter Property="Foreground" Value="{DynamicResource FgPrimaryBrush}"/>
                <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="HasDropShadow" Value="True"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="{x:Type ContextMenu}">
                            <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="0" Padding="2">
                                <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Cycle"/>
                            </Border>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style TargetType="{x:Type MenuItem}">
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="Foreground" Value="{DynamicResource FgPrimaryBrush}"/>
                <Setter Property="Padding" Value="8,6"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="{x:Type MenuItem}">
                            <Border x:Name="Bd" Background="{TemplateBinding Background}" 
                                    Padding="{TemplateBinding Padding}" CornerRadius="0">
                                <ContentPresenter ContentSource="Header" 
                                                  HorizontalAlignment="Left" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsHighlighted" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="{DynamicResource BgHoverBrush}"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
            <Style x:Key="RustToggleSwitchStyle" TargetType="CheckBox">
                <Setter Property="Background" Value="{DynamicResource BgTertiaryBrush}"/>
                <Setter Property="Foreground" Value="{DynamicResource FgPrimaryBrush}"/>
                <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="CheckBox">
                            <Grid x:Name="templateRoot" Background="Transparent" SnapsToDevicePixels="True">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Border x:Name="toggleTrack"
                                        Grid.Column="0"
                                        Width="44" Height="24"
                                        CornerRadius="0"
                                        Background="{DynamicResource BgTertiaryBrush}"
                                        BorderBrush="{DynamicResource BorderBrush}"
                                        BorderThickness="1"
                                        VerticalAlignment="Center"
                                        Margin="0,0,10,0">
                                    <Grid>
                                        <Border x:Name="toggleThumb"
                                                Width="18" Height="18"
                                                CornerRadius="0"
                                                Background="#888888"
                                                HorizontalAlignment="Left"
                                                Margin="2,0,0,0"/>
                                        <Viewbox x:Name="rustThumbLogo"
                                                 Width="19" Height="19"
                                                 HorizontalAlignment="Right"
                                                 VerticalAlignment="Center"
                                                 Margin="0,0,2,0"
                                                 Stretch="Uniform"
                                                 Visibility="Collapsed">
                                            <Canvas Width="108" Height="108">
                                                <Path Fill="White" Data="F0 m71.05 23.68c-26.06 0-47.27 21.22-47.27 47.27s21.22 47.27 47.27 47.27 47.27-21.22 47.27-47.27-21.22-47.27-47.27-47.27zm-.07 4.2a3.1 3.11 0 0 1 3.02 3.11 3.11 3.11 0 0 1 -6.22 0 3.11 3.11 0 0 1 3.2-3.11zm7.12 5.12a38.27 38.27 0 0 1 26.2 18.66l-3.67 8.28c-.63 1.43.02 3.11 1.44 3.75l7.06 3.13a38.27 38.27 0 0 1 .08 6.64h-3.93c-.39 0-.55.26-.55.64v1.8c0 4.24-2.39 5.17-4.49 5.4-2 .23-4.21-.84-4.49-2.06-1.18-6.63-3.14-8.04-6.24-10.49 3.85-2.44 7.85-6.05 7.85-10.87 0-5.21-3.57-8.49-6-10.1-3.42-2.25-7.2-2.7-8.22-2.7h-40.6a38.27 38.27 0 0 1 21.41-12.08l4.79 5.02c1.08 1.13 2.87 1.18 4 .09zm-44.2 23.02a3.11 3.11 0 0 1 3.02 3.11 3.11 3.11 0 0 1 -6.22 0 3.11 3.11 0 0 1 3.2-3.11zm74.15.14a3.11 3.11 0 0 1 3.02 3.11 3.11 3.11 0 0 1 -6.22 0 3.11 3.11 0 0 1 3.2-3.11zm-68.29.5h5.42v24.44h-10.94a38.27 38.27 0 0 1 -1.24-14.61l6.7-2.98c1.43-.64 2.08-2.31 1.44-3.74zm22.62.26h12.91c.67 0 4.71.77 4.71 3.8 0 2.51-3.1 3.41-5.65 3.41h-11.98zm0 17.56h9.89c.9 0 4.83.26 6.08 5.28.39 1.54 1.26 6.56 1.85 8.17.59 1.8 2.98 5.4 5.53 5.4h16.14a38.27 38.27 0 0 1 -3.54 4.1l-6.57-1.41c-1.53-.33-3.04.65-3.37 2.18l-1.56 7.28a38.27 38.27 0 0 1 -31.91-.15l-1.56-7.28c-.33-1.53-1.83-2.51-3.36-2.18l-6.43 1.38a38.27 38.27 0 0 1 -3.32-3.92h31.27c.35 0 .59-.06.59-.39v-11.06c0-.32-.24-.39-.59-.39h-9.15zm-14.43 25.33a3.11 3.11 0 0 1 3.02 3.11 3.11 3.11 0 0 1 -6.22 0 3.11 3.11 0 0 1 3.2-3.11zm46.05.14a3.11 3.11 0 0 1 3.02 3.11 3.11 3.11 0 0 1 -6.22 0 3.11 3.11 0 0 1 3.2-3.11z">
                                                    <Path.RenderTransform>
                                                        <TranslateTransform X="-17" Y="-17"/>
                                                    </Path.RenderTransform>
                                                </Path>
                                                <Path Fill="White" Stroke="White" StrokeThickness="3" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Data="F0 m115.68 70.95a44.63 44.63 0 0 1 -44.63 44.63 44.63 44.63 0 0 1 -44.63-44.63 44.63 44.63 0 0 1 44.63-44.63 44.63 44.63 0 0 1 44.63 44.63zm-.84-4.31 6.96 4.31-6.96 4.31 5.98 5.59-7.66 2.87 4.78 6.65-8.09 1.32 3.4 7.46-8.19-.29 1.88 7.98-7.98-1.88.29 8.19-7.46-3.4-1.32 8.09-6.65-4.78-2.87 7.66-5.59-5.98-4.31 6.96-4.31-6.96-5.59 5.98-2.87-7.66-6.65 4.78-1.32-8.09-7.46 3.4.29-8.19-7.98 1.88 1.88-7.98-8.19.29 3.4-7.46-8.09-1.32 4.78-6.65-7.66-2.87 5.98-5.59-6.96-4.31 6.96-4.31-5.98-5.59 7.66-2.87-4.78-6.65 8.09-1.32-3.4-7.46 8.19.29-1.88-7.98 7.98 1.88-.29-8.19 7.46 3.4 1.32-8.09 6.65 4.78 2.87-7.66 5.59 5.98 4.31-6.96 4.31 6.96 5.59-5.98 2.87 7.66 6.65-4.78 1.32 8.09 7.46-3.4-.29 8.19 7.98-1.88-1.88 7.98 8.19-.29-3.4 7.46 8.09 1.32-4.78 6.65 7.66 2.87z">
                                                    <Path.RenderTransform>
                                                        <TranslateTransform X="-17" Y="-17"/>
                                                    </Path.RenderTransform>
                                                </Path>
                                            </Canvas>
                                        </Viewbox>
                                    </Grid>
                                </Border>
                                <ContentPresenter x:Name="contentPresenter"
                                                  Grid.Column="1"
                                                  Focusable="False"
                                                  HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                  Margin="{TemplateBinding Padding}"
                                                  RecognizesAccessKey="True"
                                                  SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"
                                                  VerticalAlignment="Center"/>
                            </Grid>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsChecked" Value="False">
                                    <Setter TargetName="toggleTrack" Property="Background" Value="{DynamicResource BgTertiaryBrush}"/>
                                    <Setter TargetName="toggleThumb" Property="Background" Value="#888888"/>
                                    <Setter TargetName="toggleThumb" Property="Visibility" Value="Visible"/>
                                    <Setter TargetName="rustThumbLogo" Property="Visibility" Value="Collapsed"/>
                                </Trigger>
                                <Trigger Property="IsChecked" Value="True">
                                    <Setter TargetName="toggleTrack" Property="Background" Value="#867DBC"/>
                                    <Setter TargetName="toggleTrack" Property="BorderBrush" Value="#867DBC"/>
                                    <Setter TargetName="toggleThumb" Property="Visibility" Value="Collapsed"/>
                                    <Setter TargetName="rustThumbLogo" Property="Visibility" Value="Visible"/>
                                </Trigger>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="toggleThumb" Property="Background" Value="#AAAAAA"/>
                                    <Setter TargetName="toggleTrack" Property="BorderBrush" Value="#867DBC"/>
                                </Trigger>
                                <MultiTrigger>
                                    <MultiTrigger.Conditions>
                                        <Condition Property="IsMouseOver" Value="True"/>
                                        <Condition Property="IsChecked" Value="True"/>
                                    </MultiTrigger.Conditions>
                                    <Setter TargetName="toggleTrack" Property="Background" Value="#9B93CC"/>
                                    <Setter TargetName="toggleTrack" Property="BorderBrush" Value="#9B93CC"/>
                                </MultiTrigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter TargetName="toggleTrack" Property="Opacity" Value="0.5"/>
                                    <Setter TargetName="contentPresenter" Property="Opacity" Value="0.5"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </ResourceDictionary>
    </Window.Resources>
    <Grid SnapsToDevicePixels="True">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <TabControl x:Name="MainTabControl" Grid.Row="0" Margin="10"
                    Style="{DynamicResource DefaultTabControlStyle}"
                    ItemContainerStyle="{DynamicResource DefaultTabItemStyle}"
                    SnapsToDevicePixels="True">
            <TabItem>
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal">
                        <Rectangle Width="16" Height="16" Margin="0,0,8,0" VerticalAlignment="Center" HorizontalAlignment="Center" Fill="{DynamicResource FgPrimaryBrush}">
                            <Rectangle.OpacityMask>
                                <ImageBrush ImageSource="pack://siteoforigin:,,,/Other/images/icons/news.png" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality"/>
                            </Rectangle.OpacityMask>
                        </Rectangle>
                        <TextBlock Text="{Binding LocalizedUpdateNotes}"/>
                    </StackPanel>
                </TabItem.Header>
                <Grid Background="{DynamicResource BgPrimaryBrush}">
                    <wpf:WebView2 x:Name="NewsWebView" Source="https://oranges.lt/launcher.html" Margin="5"/>
                    <WebBrowser x:Name="NewsWebBrowser" Margin="5" Visibility="Collapsed" Focusable="False"/>
                    <Grid x:Name="NewsNativePanel" Margin="5" Visibility="Collapsed" Background="{DynamicResource BgPrimaryBrush}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <TextBlock x:Name="NewsNativeTitle" Grid.Row="0" Text="Update Notes" FontSize="20" FontWeight="Bold"
                                   Margin="10,10,10,4" Foreground="{DynamicResource FgPrimaryBrush}"/>
                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="10,0,10,0">
                            <StackPanel x:Name="NewsNativeStack"/>
                        </ScrollViewer>
                        <TextBlock Grid.Row="2" Margin="10,6,10,10">
                            <Hyperlink Click="NewsNativeBrowserLink_Click">
                                <TextBlock x:Name="NewsNativeBrowserText" Text="Open news in browser"/>
                            </Hyperlink>
                        </TextBlock>
                    </Grid>
                </Grid>
            </TabItem>
            <TabItem>
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal">
                        <Rectangle Width="16" Height="16" Margin="0,0,8,0" VerticalAlignment="Center" HorizontalAlignment="Center" Fill="{DynamicResource FgPrimaryBrush}">
                            <Rectangle.OpacityMask>
                                <ImageBrush ImageSource="pack://siteoforigin:,,,/Other/images/icons/logs.png" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality"/>
                            </Rectangle.OpacityMask>
                        </Rectangle>
                        <TextBlock Text="{Binding LocalizedLauncherLog}"/>
                    </StackPanel>
                </TabItem.Header>
                <Grid Background="{DynamicResource BgPrimaryBrush}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <TextBox x:Name="LogTextBox" Grid.Row="0" IsReadOnly="True" 
                           VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                           FontFamily="Consolas" FontSize="10" Margin="10"
                           Style="{DynamicResource DefaultTextBoxStyle}"/>
                    <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="10,5,10,10">
                        <Button x:Name="CopyLogButton" Padding="10,5" Margin="0,0,8,0"
                              Style="{DynamicResource DefaultButtonStyle}" Click="CopyLogButton_Click">
                            <StackPanel Orientation="Horizontal">
                                <Rectangle Width="14" Height="14" Margin="0,0,8,0" VerticalAlignment="Center" HorizontalAlignment="Center" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Control}}">
                                    <Rectangle.OpacityMask>
                                        <ImageBrush ImageSource="pack://siteoforigin:,,,/Other/images/icons/dublicate.png" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality"/>
                                    </Rectangle.OpacityMask>
                                </Rectangle>
                                <TextBlock x:Name="CopyLogText" Text="Copy Log"/>
                            </StackPanel>
                        </Button>
                        <Button x:Name="ExportLogButton" Padding="10,5" Margin="0,0,8,0"
                              Style="{DynamicResource DefaultButtonStyle}" Click="ExportLogButton_Click">
                            <StackPanel Orientation="Horizontal">
                                <Rectangle Width="14" Height="14" Margin="0,0,8,0" VerticalAlignment="Center" HorizontalAlignment="Center" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Control}}">
                                    <Rectangle.OpacityMask>
                                        <ImageBrush ImageSource="pack://siteoforigin:,,,/Other/images/icons/update.png" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality"/>
                                    </Rectangle.OpacityMask>
                                </Rectangle>
                                <TextBlock x:Name="ExportLogText" Text="Export to mclo.gs"/>
                            </StackPanel>
                        </Button>
                        <Button x:Name="ClearLogButton" Padding="10,5"
                              Style="{DynamicResource DefaultButtonStyle}" Click="ClearLogButton_Click">
                            <StackPanel Orientation="Horizontal">
                                <Rectangle Width="14" Height="14" Margin="0,0,8,0" VerticalAlignment="Center" HorizontalAlignment="Center" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Control}}">
                                    <Rectangle.OpacityMask>
                                        <ImageBrush ImageSource="pack://siteoforigin:,,,/Other/images/icons/delete.png" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality"/>
                                    </Rectangle.OpacityMask>
                                </Rectangle>
                                <TextBlock Text="{Binding LocalizedClearLog, RelativeSource={RelativeSource AncestorType=Window}}"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>
            </TabItem>
            <TabItem>
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal">
                        <Rectangle Width="16" Height="16" Margin="0,0,8,0" VerticalAlignment="Center" HorizontalAlignment="Center" Fill="{DynamicResource FgPrimaryBrush}">
                            <Rectangle.OpacityMask>
                                <ImageBrush ImageSource="pack://siteoforigin:,,,/Other/images/icons/instances.png" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality"/>
                            </Rectangle.OpacityMask>
                        </Rectangle>
                        <TextBlock Text="{Binding LocalizedGameProfiles}"/>
                    </StackPanel>
                </TabItem.Header>
                <Grid Margin="10" Background="{DynamicResource BgPrimaryBrush}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Grid x:Name="GameProfilesListView" Grid.RowSpan="2" Background="{DynamicResource BgPrimaryBrush}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <WrapPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10" VerticalAlignment="Center">
                            <TextBlock Text="{Binding LocalizedGameProfilesTitle}" FontSize="20" FontWeight="Bold" 
                                     VerticalAlignment="Center" Foreground="{DynamicResource FgPrimaryBrush}" Margin="0,0,20,5"/>
                            <Button x:Name="AddProfileButton" Margin="0,0,10,5" Padding="15,6" 
                                  Style="{DynamicResource DefaultButtonStyle}" Click="AddProfileButton_Click">
                                <StackPanel Orientation="Horizontal">
                                    <Rectangle Width="14" Height="14" Margin="0,0,8,0" VerticalAlignment="Center" HorizontalAlignment="Center" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Control}}">
                                        <Rectangle.OpacityMask>
                                            <ImageBrush ImageSource="pack://siteoforigin:,,,/Other/images/icons/newprofile.png" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality"/>
                                        </Rectangle.OpacityMask>
                                    </Rectangle>
                                    <TextBlock Text="{Binding LocalizedNewProfile}"/>
                                </StackPanel>
                            </Button>
                            <Button x:Name="ImportModpackButton" Margin="0,0,10,5" Padding="15,6" 
                                  Style="{DynamicResource DefaultButtonStyle}" Click="ImportModpackButton_Click">
                                <StackPanel Orientation="Horizontal">
                                    <Rectangle Width="14" Height="14" Margin="0,0,8,0" VerticalAlignment="Center" HorizontalAlignment="Center" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Control}}">
                                        <Rectangle.OpacityMask>
                                            <ImageBrush ImageSource="pack://siteoforigin:,,,/Other/images/icons/mrpack.png" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality"/>
                                        </Rectangle.OpacityMask>
                                    </Rectangle>
                                    <TextBlock Text="{Binding LocalizedImportMrpack, RelativeSource={RelativeSource AncestorType=Window}}"/>
                                </StackPanel>
                            </Button>
                            <Button x:Name="ImportOrangpackButton" Margin="0,0,10,5" Padding="15,6" 
                                  Style="{DynamicResource DefaultButtonStyle}" Click="ImportOrangpackButton_Click">
                                <StackPanel Orientation="Horizontal">
                                    <Rectangle Width="14" Height="14" Margin="0,0,8,0" VerticalAlignment="Center" HorizontalAlignment="Center" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Control}}">
                                        <Rectangle.OpacityMask>
                                            <ImageBrush ImageSource="pack://siteoforigin:,,,/Other/images/icons/install.png" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality"/>
                                        </Rectangle.OpacityMask>
                                    </Rectangle>
                                    <TextBlock Text="{Binding LocalizedImportOrangpack, RelativeSource={RelativeSource AncestorType=Window}}"/>
                                </StackPanel>
                            </Button>
                            <Button x:Name="ImportHpackButton" Margin="0,0,10,5" Padding="15,6" Visibility="Collapsed"
                                  Style="{DynamicResource DefaultButtonStyle}" Click="ImportHpackButton_Click">
                                <StackPanel Orientation="Horizontal">
                                    <Rectangle Width="14" Height="14" Margin="0,0,8,0" VerticalAlignment="Center" HorizontalAlignment="Center" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Control}}">
                                        <Rectangle.OpacityMask>
                                            <ImageBrush ImageSource="pack://siteoforigin:,,,/Other/images/icons/install.png" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality"/>
                                        </Rectangle.OpacityMask>
                                    </Rectangle>
                                    <TextBlock Text="{Binding LocalizedImportHpack, RelativeSource={RelativeSource AncestorType=Window}}"/>
                                </StackPanel>
                            </Button>
                        </WrapPanel>
                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <ItemsControl x:Name="ProfilesItemsControl" ItemsSource="{Binding GameInstances}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel Orientation="Horizontal" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Width="280" Height="90" Margin="0,0,15,15" Background="{DynamicResource BgSecondaryBrush}" 
                                                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="0" Padding="10">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <Image Grid.Column="0" Source="{Binding Path=., Converter={StaticResource InstanceIconConverter}}" 
                                                       Width="64" Height="64" Margin="0,0,12,0" VerticalAlignment="Center"
                                                       RenderOptions.BitmapScalingMode="HighQuality"/>
                                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Name}" FontWeight="Bold" FontSize="14" 
                                                             Foreground="{DynamicResource FgPrimaryBrush}" TextTrimming="CharacterEllipsis"
                                                             Margin="0,0,0,4"/>
                                                    <TextBlock Text="{Binding Version}" FontSize="12" Foreground="{DynamicResource FgSecondaryBrush}" Margin="0,0,0,2"/>
                                                    <TextBlock Text="{Binding ModLoader}" FontSize="11" Foreground="{DynamicResource FgTertiaryBrush}"/>
                                                </StackPanel>
                                                <Button Grid.Column="2" Padding="6" Width="28" Height="28" MinWidth="0" VerticalAlignment="Center"
                                                        Style="{DynamicResource DefaultButtonStyle}" Background="Transparent" BorderThickness="0"
                                                        Click="InstanceContextMenu_Click" Tag="{Binding}">
                                                    <Rectangle Width="16" Height="16" VerticalAlignment="Center" HorizontalAlignment="Center" Fill="{DynamicResource FgSecondaryBrush}">
                                                        <Rectangle.OpacityMask>
                                                            <ImageBrush ImageSource="pack://siteoforigin:,,,/Other/images/icons/settings.png" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality"/>
                                                        </Rectangle.OpacityMask>
                                                    </Rectangle>
                                                    <Button.ContextMenu>
                                                        <ContextMenu Opened="InstanceMenu_Opened">
                                                            <MenuItem Header="Select" Click="SelectInstance_Click" Tag="{Binding PlacementTarget.Tag, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                                                            <MenuItem Header="Edit" Click="EditInstance_Click" Tag="{Binding PlacementTarget.Tag, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                                                            <MenuItem Header="Duplicate" Click="DuplicateInstance_Click" Tag="{Binding PlacementTarget.Tag, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                                                            <MenuItem Header="Open Folder" Click="OpenInstanceFolder_Click" Tag="{Binding PlacementTarget.Tag, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                                                            <MenuItem Header="Export" Click="ExportInstance_Click" Tag="{Binding PlacementTarget.Tag, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                                                            <Separator Background="{DynamicResource BorderBrush}"/>
                                                            <MenuItem Header="Delete" Click="DeleteInstance_Click" Tag="{Binding PlacementTarget.Tag, RelativeSource={RelativeSource AncestorType=ContextMenu}}" Foreground="#FF5555"/>
                                                        </ContextMenu>
                                                    </Button.ContextMenu>
                                                </Button>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Grid>
                    <Grid x:Name="GameProfilesEditorHost" Grid.RowSpan="2" Background="{DynamicResource BgPrimaryBrush}" Visibility="Collapsed"/>
                    <Grid x:Name="GameProfilesEditView" Grid.RowSpan="2" Background="{DynamicResource BgPrimaryBrush}" Visibility="Collapsed">
                        <Grid>
                            <Border Background="{DynamicResource BgSecondaryBrush}" CornerRadius="0" Padding="30" 
                                    VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="600" MinWidth="450">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <Button Grid.Row="0" HorizontalAlignment="Right" VerticalAlignment="Top"
                                            Style="{DynamicResource IconButtonStyle}" Click="CancelProfileButton_Click"
                                            Width="32" Height="32" Margin="0,-5,-5,0">
                                        <Rectangle Width="14" Height="14" VerticalAlignment="Center" HorizontalAlignment="Center"
                                                   Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}">
                                            <Rectangle.OpacityMask>
