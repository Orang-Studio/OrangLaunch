<Window x:Class="OrangLauncher.ModDetailsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        xmlns:local="clr-namespace:OrangLauncher"
        xmlns:loc="clr-namespace:OrangLauncher.Managers"
        Title="{loc:T MODDET_TITLE, 'Project Details'}"
        Height="700" Width="900"
        MinHeight="500" MinWidth="700"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource BgPrimaryBrush}">
    <Window.Resources>
        <local:Base64ImageConverter x:Key="Base64ImageConverter"/>
    </Window.Resources>
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Border Grid.Row="0" Background="{DynamicResource BgSecondaryBrush}" CornerRadius="0" Padding="15" Margin="0,0,0,15">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Width="72" Height="72" Background="{DynamicResource BgTertiaryBrush}" 
                        CornerRadius="0" Margin="0,0,15,0" ClipToBounds="True">
                    <Image x:Name="IconImage" Stretch="UniformToFill" RenderOptions.BitmapScalingMode="HighQuality"/>
                </Border>

                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock x:Name="TitleText" FontSize="22" FontWeight="Bold" 
                               Foreground="{DynamicResource FgPrimaryBrush}"/>
                    <TextBlock x:Name="DescText" TextWrapping="Wrap" MaxHeight="48" TextTrimming="CharacterEllipsis"
                               FontSize="13" Margin="0,4,0,0"
                               Foreground="{DynamicResource FgSecondaryBrush}"/>
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="CopyLinkButton" Content="{loc:T MODDET_COPY_LINK, 'Copy Link'}" MinWidth="100" MinHeight="32" Margin="0,0,10,0"
                            Click="CopyLinkButton_Click"
                            Background="{DynamicResource BgTertiaryBrush}"
                            Foreground="{DynamicResource FgPrimaryBrush}"/>
                    <Button x:Name="OpenInBrowserButton" Content="{loc:T MODDET_OPEN_BROWSER, 'Open in Browser'}" MinWidth="120" MinHeight="32"
                            Click="OpenInBrowserButton_Click"
                            Background="{DynamicResource AccentPrimaryBrush}"
                            Foreground="{DynamicResource FgPrimaryBrush}"/>
                </StackPanel>
            </Grid>
        </Border>
        <TabControl x:Name="DetailsTabControl" Grid.Row="1" 
                    Style="{DynamicResource DefaultTabControlStyle}"
                    ItemContainerStyle="{DynamicResource DefaultTabItemStyle}"
                    Background="{DynamicResource BgSecondaryBrush}">
            <TabItem Header="{loc:T MODDET_ABOUT, 'About'}">
                <Grid Background="{DynamicResource BgPrimaryBrush}">
                    <wv2:WebView2 x:Name="AboutWebView" Visibility="Visible"/>
                    <ScrollViewer x:Name="AboutScrollViewer" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
                        <TextBlock x:Name="AboutTextBlock" TextWrapping="Wrap" Padding="15"
                                   Foreground="{DynamicResource FgPrimaryBrush}" FontSize="13"/>
                    </ScrollViewer>
                </Grid>
            </TabItem>
            
            <TabItem Header="{loc:T MODDET_VERSIONS, 'Versions'}">
                <Grid Background="{DynamicResource BgPrimaryBrush}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    
                    <ListBox x:Name="VersionsListBox" Grid.Row="0" 
                             Background="{DynamicResource BgSecondaryBrush}"
                             Foreground="{DynamicResource FgPrimaryBrush}"
                             BorderThickness="0"
                             SelectionChanged="VersionsListBox_SelectionChanged">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="10,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding Name}" FontWeight="Bold" FontSize="14"/>
                                            <TextBlock Text="{Binding VersionNumber}" FontSize="11" Margin="8,0,0,0"
                                                       VerticalAlignment="Bottom"
                                                       Foreground="{DynamicResource FgSecondaryBrush}"/>
                                        </StackPanel>
                                        <TextBlock Text="{Binding GameVersions}" FontSize="11"
                                                   Foreground="{DynamicResource FgSecondaryBrush}"/>
                                        <TextBlock Text="{Binding Loaders}" FontSize="10"
                                                   Foreground="{DynamicResource FgTertiaryBrush}"/>
                                    </StackPanel>
                                    <TextBlock Grid.Column="1" Text="{Binding DatePublished}" 
                                               VerticalAlignment="Center" Margin="15,0"
                                               Foreground="{DynamicResource FgSecondaryBrush}"/>
                                    <Button Grid.Column="2" Content="{loc:T CONTENT_INSTALL, 'Install'}" MinWidth="70" MinHeight="26"
                                            Tag="{Binding}" Click="InstallVersionButton_Click"
                                            Background="{DynamicResource AccentPrimaryBrush}"
                                            Foreground="{DynamicResource FgPrimaryBrush}"/>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </TabItem>
            
            <TabItem Header="{loc:T MODDET_CHANGELOG, 'Changelog'}">
                <Grid Margin="15" Background="{DynamicResource BgPrimaryBrush}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,15">
                        <TextBlock x:Name="ChangelogVersionText" FontWeight="Bold" FontSize="16"
                                   Foreground="{DynamicResource FgPrimaryBrush}"/>
                        <TextBlock x:Name="ChangelogDateText" FontSize="12" Margin="15,0,0,0" VerticalAlignment="Center"
                                   Foreground="{DynamicResource FgSecondaryBrush}"/>
                    </StackPanel>
                    <Border Grid.Row="1" Background="{DynamicResource BgSecondaryBrush}" CornerRadius="0" Padding="15">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <TextBlock x:Name="ChangelogTextBlock" TextWrapping="Wrap"
                                       Foreground="{DynamicResource FgPrimaryBrush}" FontSize="13"/>
                        </ScrollViewer>
                    </Border>
                </Grid>
            </TabItem>
        </TabControl>
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,15,0,0">
            <Button Content="{loc:T QT_CLOSE, 'Close'}" MinWidth="100" MinHeight="32" Click="CloseButton_Click"
                    Background="{DynamicResource BgSecondaryBrush}" Foreground="{DynamicResource FgPrimaryBrush}"/>
        </StackPanel>
    </Grid>
</Window>