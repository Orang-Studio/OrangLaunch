<Window x:Class="OrangLauncher.UpdateWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:OrangLauncher"
        xmlns:loc="clr-namespace:OrangLauncher.Managers"
        Title="{loc:T UPDWIN_TITLE, 'Check for Updates'}"
        Height="450" Width="600"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource BgPrimaryBrush}">
    <Window.Resources>
        <local:FileNameConverter x:Key="FileNameConverter"/>
    </Window.Resources>
    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <TextBlock x:Name="TitleTextBlock" Grid.Row="0" Text="{loc:T UPDWIN_AVAILABLE, 'Available Updates'}" 
                   FontSize="18" FontWeight="Bold" Margin="0,0,0,15"
                   Foreground="{DynamicResource FgPrimaryBrush}"/>
        <ListBox x:Name="UpdatesListBox" Grid.Row="1" SelectionMode="Extended"
                 Background="{DynamicResource BgSecondaryBrush}"
                 BorderBrush="{DynamicResource BorderPrimaryBrush}">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Grid Margin="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        
                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                            <TextBlock Text="{Binding Name}" FontWeight="Bold" FontSize="14"
                                       Foreground="{DynamicResource FgPrimaryBrush}"/>
                            <TextBlock FontSize="12" Foreground="{DynamicResource FgSecondaryBrush}">
                                <Run Text="{loc:T UPDWIN_CURRENT, 'Current:'}"/><Run Text=" "/><Run Text="{Binding CurrentVersion}"/>
                                <Run Text=" → "/>
                                <Run Text="{Binding LatestVersion}" 
                                     Foreground="{DynamicResource AccentPrimaryBrush}"/>
                            </TextBlock>
                        </StackPanel>
                        <CheckBox Grid.Column="1" IsChecked="{Binding IsSelected}" 
                                  VerticalAlignment="Center" Margin="10,0"/>
                    </Grid>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,15,0,0">
            <Button Content="{loc:T UPDWIN_RECHECK, 'Recheck'}" MinWidth="90" Margin="0,0,10,0" Click="RecheckButton_Click"
                    Background="{DynamicResource BgSecondaryBrush}" Foreground="{DynamicResource FgPrimaryBrush}"/>
            <Button Content="{loc:T REMOVE_SELECTED, 'Remove Selected'}" MinWidth="120" Margin="0,0,10,0" Click="RemoveSelectedButton_Click"
                    Background="{DynamicResource BgSecondaryBrush}" Foreground="{DynamicResource FgPrimaryBrush}"/>
            <Button Content="{loc:T UPDWIN_UPDATE_SELECTED, 'Update Selected'}" MinWidth="120" Margin="0,0,10,0" Click="UpdateSelectedButton_Click"
                    Background="{DynamicResource AccentPrimaryBrush}" Foreground="{DynamicResource FgPrimaryBrush}"/>
            <Button Content="{loc:T UPDWIN_UPDATE_ALL, 'Update All'}" MinWidth="100" Click="UpdateAllButton_Click"
                    Background="{DynamicResource AccentPrimaryBrush}" Foreground="{DynamicResource FgPrimaryBrush}"/>
        </StackPanel>
        <ProgressBar x:Name="UpdateProgressBar" Grid.Row="3" Height="4" Margin="0,10,0,0"
                     IsIndeterminate="False" Visibility="Collapsed"
                     Foreground="{DynamicResource AccentPrimaryBrush}"/>
    </Grid>
</Window>