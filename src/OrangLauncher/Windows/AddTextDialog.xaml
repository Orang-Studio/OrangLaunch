<Window x:Class="OrangLauncher.AddTextDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Input Dialog"
        SizeToContent="Height" Width="380"
        WindowStartupLocation="CenterOwner"
        WindowStyle="ToolWindow"
        ResizeMode="NoResize"
        Background="{DynamicResource BgPrimaryBrush}">
    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <TextBlock x:Name="PromptText" Grid.Row="0" Text="Enter text:" Margin="0,0,0,10" 
                   Foreground="{DynamicResource FgPrimaryBrush}"/>
        <TextBox x:Name="InputTextBox" Grid.Row="1" Style="{DynamicResource DefaultTextBoxStyle}"/>
        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,15,0,0">
            <Button x:Name="OkButton" Content="OK" MinWidth="90" Margin="0,0,10,0" Click="OkButton_Click" IsDefault="True" Style="{DynamicResource DefaultButtonStyle}"/>
            <Button x:Name="CancelButton" Content="Cancel" MinWidth="90" Click="CancelButton_Click" IsCancel="True" Style="{DynamicResource DefaultButtonStyle}"/>
        </StackPanel>
    </Grid>
</Window>