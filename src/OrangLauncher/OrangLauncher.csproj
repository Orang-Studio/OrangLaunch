<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <Platforms>x86;ARM64</Platforms>
    <RuntimeIdentifiers>win-x86;win-arm64</RuntimeIdentifiers>
    <AssemblyName>OrangLauncher</AssemblyName>
    <RootNamespace>OrangLauncher</RootNamespace>
    <ApplicationIcon Condition="Exists('..\..\assets\Other\images\orange.ico')">..\..\assets\Other\images\orange.ico</ApplicationIcon>
    <LauncherVersion>$([System.IO.File]::ReadAllText('$(MSBuildThisFileDirectory)..\..\version.txt').Trim())</LauncherVersion>
    <Version>$(LauncherVersion)</Version>
    <InformationalVersion>$(LauncherVersion)</InformationalVersion>
  </PropertyGroup>
  <ItemGroup>
    <Using Include="System.IO" />
    <Using Include="System.Net.Http" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="fNbt" Version="1.0.0" />
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.3856.49" />
    <PackageReference Include="SkiaSharp" Version="2.88.8" />
  </ItemGroup>
  <ItemGroup>
    <Content Include="..\..\assets\Other\**" LinkBase="Other">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>
</Project>