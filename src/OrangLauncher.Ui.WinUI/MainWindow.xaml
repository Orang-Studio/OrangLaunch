<Window
    x:Class="OrangLauncher.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:OrangLauncher"
    xmlns:olcontrols="using:OrangLauncher.Controls"
    xmlns:controls="using:Microsoft.UI.Xaml.Controls"
    Title="OrangLauncher">

    <Grid x:Name="RootGrid" Background="{ThemeResource BgPrimaryBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <NavigationView x:Name="MainNavView"
                        Grid.Row="0"
                        PaneDisplayMode="Top"
                        IsSettingsVisible="False"
                        IsBackButtonVisible="Collapsed"
                        SelectionChanged="MainNavView_SelectionChanged">
            <NavigationView.ContentTransitions>
                <TransitionCollection/>
            </NavigationView.ContentTransitions>
            <NavigationView.PaneCustomContent>
                <Grid x:Name="TitleBarDragArea" Background="Transparent" MinWidth="40"/>
            </NavigationView.PaneCustomContent>
            <NavigationView.MenuItems>
                <NavigationViewItem Content="Update Notes" Tag="news">
                    <NavigationViewItem.Icon>
                        <FontIcon Style="{StaticResource IconNews}"/>
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="Launcher Log" Tag="log">
                    <NavigationViewItem.Icon>
                        <FontIcon Style="{StaticResource IconLogs}"/>
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="Game Profiles" Tag="profiles">
                    <NavigationViewItem.Icon>
                        <FontIcon Style="{StaticResource IconInstances}"/>
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="Resource &amp; Shader Packs" Tag="resources">
                    <NavigationViewItem.Icon>
                        <FontIcon Style="{StaticResource IconResoucepacks}"/>
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="Server Manager" Tag="servers">
                    <NavigationViewItem.Icon>
                        <FontIcon Style="{StaticResource IconServers}"/>
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="Content" Tag="content">
                    <NavigationViewItem.Icon>
                        <FontIcon Style="{StaticResource IconDownload}"/>
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="Settings" Tag="settings">
                    <NavigationViewItem.Icon>
                        <FontIcon Style="{StaticResource IconSettings}"/>
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.MenuItems>
            <Grid>
                <Grid x:Name="NewsPanel" Visibility="Visible">
                    <WebView2 x:Name="NewsWebView" Margin="5"/>
                    <ScrollViewer x:Name="NewsNativePanel" Visibility="Collapsed" Margin="5"
                                  VerticalScrollBarVisibility="Auto">
                        <StackPanel MaxWidth="760" HorizontalAlignment="Center" Padding="24,18,24,28" Spacing="4">
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock x:Name="NewsNativeTitle" FontSize="24" FontWeight="Bold" VerticalAlignment="Center"
                                           Foreground="{ThemeResource FgPrimaryBrush}"/>
                                <Button x:Name="NewsNativeBrowserButton" Grid.Column="1" Padding="12,6"
                                        Click="NewsOpenBrowserButton_Click">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <FontIcon Glyph="&#xE774;" FontSize="13"/>
                                        <TextBlock x:Name="NewsNativeBrowserText" Text="Open in browser" FontSize="12"/>
                                    </StackPanel>
                                </Button>
                            </Grid>
                            <StackPanel x:Name="NewsNativeStack" Spacing="4"/>
                        </StackPanel>
                    </ScrollViewer>
                    <StackPanel x:Name="NewsFallbackPanel" Visibility="Collapsed" VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="10">
                        <TextBlock x:Name="NewsFallbackText" Text="News cannot be shown because WebView2 is not available."
                                   TextWrapping="Wrap" HorizontalAlignment="Center" Foreground="{ThemeResource FgSecondaryBrush}"/>
                        <Button x:Name="NewsOpenBrowserButton" HorizontalAlignment="Center" Content="Open news in browser" Click="NewsOpenBrowserButton_Click"/>
                    </StackPanel>
                </Grid>
                <Grid x:Name="LogPanel" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <TextBox x:Name="LogTextBox" Grid.Row="0" IsReadOnly="True"
                             AcceptsReturn="True" TextWrapping="Wrap"
                             FontFamily="Consolas" FontSize="10" Margin="10"
                             ScrollViewer.VerticalScrollBarVisibility="Auto"
                             Background="{ThemeResource BgSecondaryBrush}"
                             Foreground="{ThemeResource FgPrimaryBrush}"/>
                    <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="10,5,10,10" Spacing="8">
                        <Button x:Name="CopyLogButton" Padding="10,5" Click="CopyLogButton_Click">
                            <StackPanel Orientation="Horizontal">
                                <FontIcon Style="{StaticResource IconDublicate}" FontSize="14" Margin="0,0,8,0"/>
                                <TextBlock x:Name="CopyLogText" Text="Copy Log"/>
                            </StackPanel>
                        </Button>
                        <Button x:Name="ExportLogButton" Padding="10,5" Click="ExportLogButton_Click">
                            <StackPanel Orientation="Horizontal">
                                <FontIcon Style="{StaticResource IconUpdate}" FontSize="14" Margin="0,0,8,0"/>
                                <TextBlock x:Name="ExportLogText" Text="Export to mclo.gs"/>
                            </StackPanel>
                        </Button>
                        <Button x:Name="ClearLogButton" Padding="10,5" Click="ClearLogButton_Click">
                            <StackPanel Orientation="Horizontal">
                                <FontIcon Style="{StaticResource IconDelete}" FontSize="14" Margin="0,0,8,0"/>
                                <TextBlock x:Name="ClearLogText" Text="Clear Log"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>
                <Grid x:Name="ProfilesPanel" Visibility="Collapsed" Margin="10">
                    <Grid x:Name="GameProfilesListView">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">
                            <TextBlock x:Name="GameProfilesTitleText" Text="GAME PROFILES" FontSize="20" FontWeight="Bold"
                                       VerticalAlignment="Center" Foreground="{ThemeResource FgPrimaryBrush}" Margin="0,0,20,0"/>
                            <Button x:Name="AddProfileButton" Margin="0,0,10,0" Padding="15,6" Click="AddProfileButton_Click">
                                <StackPanel Orientation="Horizontal">
                                    <FontIcon Style="{StaticResource IconNewProfile}" FontSize="14" Margin="0,0,8,0"/>
                                    <TextBlock x:Name="NewProfileBtnText" Text="NEW PROFILE"/>
                                </StackPanel>
                            </Button>
                            <Button x:Name="ImportModpackButton" Margin="0,0,10,0" Padding="15,6" Click="ImportModpackButton_Click">
                                <StackPanel Orientation="Horizontal">
                                    <FontIcon Style="{StaticResource IconMrpack}" FontSize="14" Margin="0,0,8,0"/>
                                    <TextBlock x:Name="ImportMrpackBtnText" Text="Import .mrpack"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                            <ItemsRepeater x:Name="ProfilesItemsControl" ItemsSource="{x:Bind GameInstances, Mode=OneWay}">
                                <ItemsRepeater.Layout>
                                    <UniformGridLayout MinItemWidth="280" MinItemHeight="90"
                                                       MinColumnSpacing="15" MinRowSpacing="15"
                                                       ItemsStretch="None"/>
                                </ItemsRepeater.Layout>
                                <ItemsRepeater.ItemTemplate>
                                    <DataTemplate x:DataType="local:InstanceCardModel">
                                        <Border Width="280" Height="90"
                                                Background="{ThemeResource BgSecondaryBrush}"
                                                BorderBrush="{ThemeResource AppBorderBrush}"
                                                BorderThickness="1" CornerRadius="4" Padding="10">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <Image Grid.Column="0" Source="{x:Bind IconSource, Mode=OneWay}"
                                                       Width="64" Height="64" Margin="0,0,12,0" VerticalAlignment="Center"/>
                                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                    <TextBlock Text="{x:Bind Name}" FontWeight="Bold" FontSize="14"
                                                               Foreground="{ThemeResource FgPrimaryBrush}" TextTrimming="CharacterEllipsis"
                                                               Margin="0,0,0,4"/>
                                                    <TextBlock Text="{x:Bind Version}" FontSize="12"
                                                               Foreground="{ThemeResource FgSecondaryBrush}" Margin="0,0,0,2"/>
                                                    <TextBlock Text="{x:Bind ModLoader}" FontSize="11"
                                                               Foreground="{ThemeResource FgTertiaryBrush}"/>
                                                </StackPanel>
                                                <Button Grid.Column="2" Padding="6" Width="28" Height="28"
                                                        VerticalAlignment="Center" Background="Transparent" BorderThickness="0"
                                                        Tag="{x:Bind InstanceId}">
                                                    <FontIcon Style="{StaticResource IconSettings}" FontSize="16"
                                                              Foreground="{ThemeResource FgPrimaryBrush}"/>
                                                    <Button.Flyout>
                                                        <MenuFlyout>
                                                            <MenuFlyoutItem Text="Select" Click="SelectInstance_Click" Tag="{x:Bind InstanceId}"/>
                                                            <MenuFlyoutItem Text="Edit" Click="EditInstance_Click" Tag="{x:Bind InstanceId}"/>
                                                            <MenuFlyoutItem Text="Duplicate" Click="DuplicateInstance_Click" Tag="{x:Bind InstanceId}"/>
                                                            <MenuFlyoutItem Text="Open Folder" Click="OpenInstanceFolder_Click" Tag="{x:Bind InstanceId}"/>
                                                            <MenuFlyoutSeparator/>
                                                            <MenuFlyoutItem Text="Delete" Click="DeleteInstance_Click" Tag="{x:Bind InstanceId}">
                                                                <MenuFlyoutItem.Foreground>
                                                                    <SolidColorBrush Color="#FF5555"/>
                                                                </MenuFlyoutItem.Foreground>
                                                            </MenuFlyoutItem>
                                                        </MenuFlyout>
                                                    </Button.Flyout>
                                                </Button>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsRepeater.ItemTemplate>
                            </ItemsRepeater>
                        </ScrollViewer>
                    </Grid>

                    <!-- Edit View -->
                    <Grid x:Name="GameProfilesEditView" Visibility="Collapsed">
                        <Border Background="{ThemeResource BgSecondaryBrush}" CornerRadius="10" Padding="20,20,20,30"
                                VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="600" MinWidth="450">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <Button Grid.Row="0" HorizontalAlignment="Right" VerticalAlignment="Top"
                                        Click="CancelProfileButton_Click" Width="32" Height="32" Padding="0"
                                        Background="Transparent" BorderThickness="0" Margin="0,0,0,10">
                                    <FontIcon Style="{StaticResource IconRemove}" FontSize="14" Foreground="{ThemeResource FgPrimaryBrush}"/>
                                </Button>
                                <StackPanel Grid.Row="1" HorizontalAlignment="Center" Margin="0,0,0,20">
                                    <Button x:Name="InstanceIconButton" Width="64" Height="64"
                                            Background="Transparent" BorderThickness="0" Click="InstanceIconButton_Click">
                                        <Grid>
                                            <Image x:Name="InstanceIconImage" Width="48" Height="48"/>
                                            <FontIcon Style="{StaticResource IconEdit}" FontSize="14"
                                                      Margin="0,0,5,5" VerticalAlignment="Bottom" HorizontalAlignment="Right"/>
                                        </Grid>
                                    </Button>
                                    <TextBlock x:Name="EditProfileTitle" Text="Create Profile" FontSize="20" FontWeight="Bold"
                                               Foreground="{ThemeResource FgPrimaryBrush}" HorizontalAlignment="Center" Margin="0,10,0,0"/>
                                </StackPanel>
                                <ScrollViewer Grid.Row="2" MaxHeight="400" VerticalScrollBarVisibility="Auto">
                                    <StackPanel Margin="0,0,10,0">
                                        <TextBlock x:Name="EditLblName" Text="Name" Foreground="{ThemeResource FgPrimaryBrush}" Margin="0,0,0,5"/>
                                        <TextBox x:Name="ProfileNameTextBox" Margin="0,0,0,15"/>

                                        <Grid Margin="0,0,0,15">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="10"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0">
                                                <TextBlock x:Name="EditLblModLoader" Text="Mod Loader" Foreground="{ThemeResource FgPrimaryBrush}" Margin="0,0,0,5"/>
                                                <ComboBox x:Name="ProfileModLoaderComboBox" HorizontalAlignment="Stretch"
                                                          SelectionChanged="ProfileModLoaderComboBox_SelectionChanged">
                                                    <ComboBoxItem Content="Vanilla" Tag="vanilla"/>
                                                    <ComboBoxItem Content="Forge" Tag="forge"/>
                                                    <ComboBoxItem Content="Fabric" Tag="fabric"/>
                                                    <ComboBoxItem Content="Quilt" Tag="quilt"/>
                                                    <ComboBoxItem Content="NeoForge" Tag="neoforge"/>
                                                    <ComboBoxItem Content="OptiFine" Tag="optifine"/>
                                                </ComboBox>
                                            </StackPanel>
                                            <StackPanel Grid.Column="2">
                                                <TextBlock x:Name="EditLblLoaderVersion" Text="Loader Version" Foreground="{ThemeResource FgPrimaryBrush}" Margin="0,0,0,5"/>
                                                <ComboBox x:Name="ProfileModLoaderVersionComboBox" HorizontalAlignment="Stretch"
                                                          IsEditable="True"/>
                                            </StackPanel>
                                        </Grid>
                                        <TextBlock x:Name="EditLblVersion" Text="Version" Foreground="{ThemeResource FgPrimaryBrush}" Margin="0,0,0,5"/>
                                        <ComboBox x:Name="ProfileVersionComboBox" HorizontalAlignment="Stretch" Margin="0,0,0,15" SelectionChanged="ProfileVersionComboBox_SelectionChanged"/>

                                        <TextBlock x:Name="EditLblRam" Text="RAM" Foreground="{ThemeResource FgPrimaryBrush}" Margin="0,0,0,5"/>
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,15">
                                            <TextBlock x:Name="RamValueText" Text="4096 MB"
                                                       Foreground="{ThemeResource FgPrimaryBrush}" Width="70" VerticalAlignment="Center"/>
                                            <Slider x:Name="ProfileRamSlider" Width="300" Minimum="1024" Maximum="32768"
                                                    StepFrequency="512" SnapsTo="StepValues"
                                                    SmallChange="512" LargeChange="1024" VerticalAlignment="Center"
                                                    ValueChanged="ProfileRamSlider_ValueChanged"/>
                                        </StackPanel>
                                        <TextBlock x:Name="EditLblPerformance" Text="Performance Tier" Foreground="{ThemeResource FgPrimaryBrush}" Margin="0,0,0,5"/>
                                        <ComboBox x:Name="ProfilePerformanceTierComboBox" HorizontalAlignment="Stretch" Margin="0,0,0,15">
                                            <ComboBoxItem Content="Auto (Detect)" Tag="Auto" IsSelected="True"/>
                                            <ComboBoxItem Content="Low (Conservative)" Tag="Low"/>
                                            <ComboBoxItem Content="Mid (Balanced)" Tag="Mid"/>
                                            <ComboBoxItem Content="High (Aggressive)" Tag="High"/>
                                        </ComboBox>
                                        <TextBlock x:Name="EditLblStartupArgs" Text="Startup Arguments" Foreground="{ThemeResource FgPrimaryBrush}" Margin="0,0,0,5"/>
                                        <TextBlock x:Name="EditLblStartupArgsDesc" Text="Shows all arguments that will be used. Fully editable."
                                                   FontSize="10" Foreground="{ThemeResource FgTertiaryBrush}" Margin="0,0,0,5"/>
                                        <TextBox x:Name="ProfileJavaArgsTextBox" Margin="0,0,0,15"/>
                                        <TextBlock x:Name="EditLblJavaVersion" Text="Java Version" Foreground="{ThemeResource FgPrimaryBrush}" Margin="0,0,0,5"/>
                                        <ComboBox x:Name="ProfileJavaVersionComboBox" HorizontalAlignment="Stretch" Margin="0,0,0,10"/>
                                    </StackPanel>
                                </ScrollViewer>
                                <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,20,0,0">
                                    <Button x:Name="SaveProfileButton" Margin="0,0,10,0" Padding="30,8" Click="SaveProfileButton_Click">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock x:Name="SaveProfileBtnText" Text="Save"/>
                                        </StackPanel>
                                    </Button>
                                    <Button Padding="30,8" Click="CancelProfileButton_Click">
                                        <StackPanel Orientation="Horizontal">
                                            <FontIcon Style="{StaticResource IconClose}" FontSize="14" Margin="0,0,8,0"/>
                                            <TextBlock x:Name="CancelProfileBtnText" Text="Cancel"/>
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </Grid>
                </Grid>

                <!-- Resource/Shader/Mods Panel -->
                <Grid x:Name="ResourcesPanel" Visibility="Collapsed" Margin="10">
                    <NavigationView x:Name="ResourcesNavView"
                                    PaneDisplayMode="Top"
                                    IsSettingsVisible="False"
                                    IsBackButtonVisible="Collapsed"
                                    SelectionChanged="ResourcesNavView_SelectionChanged">
                        <NavigationView.Resources>
                            <!-- Blend the nav content area into the app background instead of
                                 the default layer color, which reads as a different page. -->
                            <SolidColorBrush x:Key="NavigationViewContentBackground" Color="Transparent"/>
                            <SolidColorBrush x:Key="NavigationViewContentGridBorderBrush" Color="Transparent"/>
                        </NavigationView.Resources>
                        <NavigationView.ContentTransitions>
                            <TransitionCollection/>
                        </NavigationView.ContentTransitions>
                        <NavigationView.MenuItems>
                            <NavigationViewItem Content="Resource Packs" Tag="resourcepacks">
                                <NavigationViewItem.Icon>
                                    <FontIcon Style="{StaticResource IconResoucepacks}"/>
                                </NavigationViewItem.Icon>
                            </NavigationViewItem>
                            <NavigationViewItem Content="Shader Packs" Tag="shaderpacks">
                                <NavigationViewItem.Icon>
                                    <FontIcon Style="{StaticResource IconShaderpacks}"/>
                                </NavigationViewItem.Icon>
                            </NavigationViewItem>
                            <NavigationViewItem x:Name="ModdingNavItem" Content="Modding" Tag="modding">
                                <NavigationViewItem.Icon>
                                    <FontIcon Style="{StaticResource IconMods}"/>
                                </NavigationViewItem.Icon>
                            </NavigationViewItem>
                        </NavigationView.MenuItems>
                        <Grid>
                            <!-- Resource Packs Sub-Panel -->
                            <Grid x:Name="ResourcePacksSubPanel" Visibility="Visible">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <StackPanel Grid.Row="0" Margin="0,0,0,10">
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                        <TextBlock x:Name="RpSearchLabel" Text="Search:" VerticalAlignment="Center" Margin="0,0,10,0" Foreground="{ThemeResource FgPrimaryBrush}"/>
                                        <TextBox x:Name="ResourcePacksSearchTextBox" MinWidth="250" MaxWidth="500"
                                                 TextChanged="ResourcePacksSearchTextBox_TextChanged"/>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Spacing="10">
                                        <Button Click="RefreshResourcePacksButton_Click" Padding="10,5">
                                            <StackPanel Orientation="Horizontal">
                                                <FontIcon Style="{StaticResource IconRefresh}" FontSize="14" Margin="0,0,8,0"/>
                                                <TextBlock x:Name="RpRefreshBtn" Text="Refresh"/>
                                            </StackPanel>
                                        </Button>
                                        <Button Click="AddResourcePackButton_Click" Padding="10,5">
                                            <StackPanel Orientation="Horizontal">
                                                <FontIcon Style="{StaticResource IconAdd}" FontSize="14" Margin="0,0,8,0"/>
                                                <TextBlock x:Name="RpAddBtn" Text="Add Pack"/>
                                            </StackPanel>
                                        </Button>
                                        <Button Click="UpdateResourcePacksButton_Click" Padding="10,5">
                                            <StackPanel Orientation="Horizontal">
                                                <FontIcon Style="{StaticResource IconUpdate}" FontSize="14" Margin="0,0,8,0"/>
                                                <TextBlock x:Name="RpUpdateBtn" Text="Update"/>
                                            </StackPanel>
                                        </Button>
                                        <Button Click="RemoveResourcePackButton_Click" Padding="10,5">
                                            <StackPanel Orientation="Horizontal">
                                                <FontIcon Style="{StaticResource IconRemove}" FontSize="14" Margin="0,0,8,0"/>
                                                <TextBlock x:Name="RpRemoveBtn" Text="Remove"/>
                                            </StackPanel>
                                        </Button>
                                        <Button Click="OpenResourcePacksButton_Click" Padding="10,5">
                                            <StackPanel Orientation="Horizontal">
                                                <FontIcon Style="{StaticResource IconFolder}" FontSize="14" Margin="0,0,8,0"/>
                                                <TextBlock x:Name="RpOpenFolderBtn" Text="Open Folder"/>
                                            </StackPanel>
                                        </Button>
                                    </StackPanel>
                                </StackPanel>
                                <ListView x:Name="ResourcePacksListBox" Grid.Row="1" SelectionMode="Extended"/>
                            </Grid>

                            <!-- Shader Packs Sub-Panel -->
                            <Grid x:Name="ShaderPacksSubPanel" Visibility="Collapsed">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <StackPanel Grid.Row="0" Margin="0,0,0,10">
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                        <TextBlock x:Name="SpSearchLabel" Text="Search:" VerticalAlignment="Center" Margin="0,0,10,0" Foreground="{ThemeResource FgPrimaryBrush}"/>
                                        <TextBox x:Name="ShaderPacksSearchTextBox" MinWidth="250" MaxWidth="500"
                                                 TextChanged="ShaderPacksSearchTextBox_TextChanged"/>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Spacing="10">
                                        <Button Click="AddShaderPackButton_Click" Padding="10,5">
                                            <StackPanel Orientation="Horizontal">
                                                <FontIcon Style="{StaticResource IconAdd}" FontSize="14" Margin="0,0,8,0"/>
                                                <TextBlock x:Name="SpAddBtn" Text="Add Shader"/>
                                            </StackPanel>
                                        </Button>
                                        <Button Click="UpdateShaderPacksButton_Click" Padding="10,5">
                                            <StackPanel Orientation="Horizontal">
                                                <FontIcon Style="{StaticResource IconUpdate}" FontSize="14" Margin="0,0,8,0"/>
                                                <TextBlock x:Name="SpUpdateBtn" Text="Update"/>
                                            </StackPanel>
                                        </Button>
                                        <Button Click="RefreshShaderPacksButton_Click" Padding="10,5">
                                            <StackPanel Orientation="Horizontal">
                                                <FontIcon Style="{StaticResource IconRefresh}" FontSize="14" Margin="0,0,8,0"/>
                                                <TextBlock x:Name="SpRefreshBtn" Text="Refresh"/>
                                            </StackPanel>
                                        </Button>
                                        <Button Click="RemoveShaderPackButton_Click" Padding="10,5">
                                            <StackPanel Orientation="Horizontal">
                                                <FontIcon Style="{StaticResource IconRemove}" FontSize="14" Margin="0,0,8,0"/>
                                                <TextBlock x:Name="SpRemoveBtn" Text="Remove"/>
                                            </StackPanel>
                                        </Button>
                                        <Button Click="OpenShaderPacksButton_Click" Padding="10,5">
                                            <StackPanel Orientation="Horizontal">
                                                <FontIcon Style="{StaticResource IconFolder}" FontSize="14" Margin="0,0,8,0"/>
                                                <TextBlock x:Name="SpOpenFolderBtn" Text="Open Folder"/>
                                            </StackPanel>
                                        </Button>
                                    </StackPanel>
                                </StackPanel>
                                <ListView x:Name="ShaderPacksListBox" Grid.Row="1" SelectionMode="Extended"/>
                            </Grid>

                            <!-- Modding Sub-Panel -->
                            <Grid x:Name="ModdingSubPanel" Visibility="Collapsed">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <StackPanel Grid.Row="0" Margin="0,0,0,10">
                                    <Grid Margin="0,0,0,5">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" x:Name="ModsTitleText" Text="Mods" FontSize="20" FontWeight="Bold"
                                                   Foreground="{ThemeResource FgPrimaryBrush}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                        <TextBlock Grid.Column="1" x:Name="ModsProfileInfoTextBlock" Text=" | Profile: None"
                                                   VerticalAlignment="Center" Foreground="{ThemeResource FgSecondaryBrush}"/>
                                        <TextBlock Grid.Column="2" x:Name="ModsSearchLabel" Text="Search:" VerticalAlignment="Center" Margin="20,0,10,0"
                                                   Foreground="{ThemeResource FgPrimaryBrush}"/>
                                        <TextBox Grid.Column="3" x:Name="ModsSearchTextBox" Width="200"
                                                 TextChanged="ModsSearchTextBox_TextChanged" VerticalAlignment="Center"/>
                                    </Grid>
                                    <StackPanel Orientation="Horizontal" Spacing="10">
                                        <Button Click="AddModButton_Click" Padding="15,5">
                                            <StackPanel Orientation="Horizontal">
                                                <FontIcon Style="{StaticResource IconAdd}" FontSize="14" Margin="0,0,8,0"/>
                                                <TextBlock x:Name="ModAddBtn" Text="Add Mod"/>
                                            </StackPanel>
                                        </Button>
                                        <Button Click="UpdateModsButton_Click" Padding="15,5">
                                            <StackPanel Orientation="Horizontal">
                                                <FontIcon Style="{StaticResource IconUpdate}" FontSize="14" Margin="0,0,8,0"/>
                                                <TextBlock x:Name="ModUpdateBtn" Text="Update"/>
                                            </StackPanel>
                                        </Button>
                                        <Button Click="RefreshModsButton_Click" Padding="15,5">
                                            <StackPanel Orientation="Horizontal">
                                                <FontIcon Style="{StaticResource IconRefresh}" FontSize="14" Margin="0,0,8,0"/>
                                                <TextBlock x:Name="ModRefreshBtn" Text="Refresh"/>
                                            </StackPanel>
                                        </Button>
                                        <Button Click="RemoveModButton_Click" Padding="15,5">
                                            <StackPanel Orientation="Horizontal">
                                                <FontIcon Style="{StaticResource IconRemove}" FontSize="14" Margin="0,0,8,0"/>
                                                <TextBlock x:Name="ModRemoveBtn" Text="Remove Selected"/>
                                            </StackPanel>
                                        </Button>
                                        <Button Click="OpenModsFolderButton_Click" Padding="15,5">
                                            <StackPanel Orientation="Horizontal">
                                                <FontIcon Style="{StaticResource IconFolder}" FontSize="14" Margin="0,0,8,0"/>
                                                <TextBlock x:Name="ModOpenFolderBtn" Text="Open Folder"/>
                                            </StackPanel>
                                        </Button>
                                        <Button Click="ImportModpackButton_Click" Padding="15,5">
                                            <StackPanel Orientation="Horizontal">
                                                <FontIcon Style="{StaticResource IconMrpack}" FontSize="14" Margin="0,0,8,0"/>
                                                <TextBlock x:Name="ModImportBtn" Text="Import .mrpack"/>
                                            </StackPanel>
                                        </Button>
                                    </StackPanel>
                                </StackPanel>
                                <ListView x:Name="ModsListBox" Grid.Row="1" Margin="0,0,0,10" SelectionMode="Extended"/>
                                <TextBlock x:Name="ModCountTextBlock" Grid.Row="2" Text="0 mods loaded"
                                           HorizontalAlignment="Right" Foreground="{ThemeResource FgSecondaryBrush}"/>
                            </Grid>
                        </Grid>
                    </NavigationView>
                </Grid>

                <!-- Server Manager Panel -->
                <Grid x:Name="ServersPanel" Visibility="Collapsed" Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10" Spacing="10">
                        <TextBlock x:Name="ServerManagerTitle" Text="Server Manager" FontSize="20" FontWeight="Bold"
                                   Foreground="{ThemeResource FgPrimaryBrush}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                        <Button Click="AddServerButton_Click" Padding="15,6">
                            <StackPanel Orientation="Horizontal">
                                <FontIcon Style="{StaticResource IconAdd}" FontSize="14" Margin="0,0,8,0"/>
                                <TextBlock x:Name="AddServerBtnText" Text="Add Server"/>
                            </StackPanel>
                        </Button>
                        <Button Click="RefreshServerButton_Click" Padding="15,6">
                            <StackPanel Orientation="Horizontal">
                                <FontIcon Style="{StaticResource IconRefresh}" FontSize="14" Margin="0,0,8,0"/>
                                <TextBlock x:Name="SrvRefreshBtn" Text="Refresh"/>
                            </StackPanel>
                        </Button>
                        <Button Click="RemoveServerButton_Click" Padding="15,6">
                            <StackPanel Orientation="Horizontal">
                                <FontIcon Style="{StaticResource IconRemove}" FontSize="14" Margin="0,0,8,0"/>
                                <TextBlock x:Name="SrvRemoveBtn" Text="Remove Selected"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                    <ListView x:Name="ServersListBox" Grid.Row="1" SelectionMode="Single">
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Grid Padding="8,6" ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid Grid.Column="0" Width="32" Height="32" VerticalAlignment="Center">
                                        <FontIcon Style="{StaticResource IconServer}" FontSize="22"
                                                  Foreground="{ThemeResource FgTertiaryBrush}"/>
                                        <Image Source="{Binding ServerIconImage}" Width="32" Height="32"
                                               Visibility="{Binding HasServerIcon}"/>
                                    </Grid>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="14"
                                                   Foreground="{ThemeResource FgPrimaryBrush}"/>
                                        <TextBlock Text="{Binding Ip}" FontSize="12"
                                                   Foreground="{ThemeResource FgTertiaryBrush}"/>
                                    </StackPanel>
                                    <TextBlock Grid.Column="2" Text="{Binding PlayerCountText}" FontSize="12"
                                               VerticalAlignment="Center" Foreground="{ThemeResource FgSecondaryBrush}"/>
                                    <Image Grid.Column="3" Source="{Binding PingIcon}" Width="24" Height="18"
                                           VerticalAlignment="Center" ToolTipService.ToolTip="{Binding PingText}"/>
                                    <Button Grid.Column="4" Padding="12,4" VerticalAlignment="Center"
                                            Tag="{Binding}" Click="QuickPlayServerButton_Click">
                                        <StackPanel Orientation="Horizontal">
                                            <FontIcon Style="{StaticResource IconPlay}" FontSize="12" Margin="0,0,6,0"/>
                                            <TextBlock Text="Play"/>
                                        </StackPanel>
                                    </Button>
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Grid>

                <!-- Settings Panel -->
                <Grid x:Name="ContentPanel" Visibility="Collapsed" Margin="10">
                    <NavigationView x:Name="ContentNavView" PaneDisplayMode="Top" IsSettingsVisible="False"
                                    IsBackButtonVisible="Collapsed" SelectionChanged="ContentNavView_SelectionChanged">
                        <NavigationView.Resources>
                            <!-- Blend the nav content area into the app background instead of
                                 the default layer color, which reads as a different page. -->
                            <SolidColorBrush x:Key="NavigationViewContentBackground" Color="Transparent"/>
                            <SolidColorBrush x:Key="NavigationViewContentGridBorderBrush" Color="Transparent"/>
                        </NavigationView.Resources>
                        <NavigationView.MenuItems>
                            <NavigationViewItem x:Name="ContentTabMods" Content="Mods" Tag="mod" IsSelected="True"/>
                            <NavigationViewItem x:Name="ContentTabResourcePacks" Content="Resource Packs" Tag="resourcepack"/>
                            <NavigationViewItem x:Name="ContentTabDataPacks" Content="Data Packs" Tag="datapack"/>
                            <NavigationViewItem x:Name="ContentTabShaders" Content="Shaders" Tag="shader"/>
                            <NavigationViewItem x:Name="ContentTabModpacks" Content="Modpacks" Tag="modpack"/>
                            <NavigationViewItem x:Name="ContentTabOrangLib" Content="OrangLib" Tag="oranglib"/>
                        </NavigationView.MenuItems>
                        <Grid Margin="0,10,0,0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Grid Grid.Row="0" ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="ContentSearchBox" Grid.Column="0" PlaceholderText="Search content..." KeyDown="ContentSearchBox_KeyDown"/>
                                <Button x:Name="ContentSearchButton" Grid.Column="1" Content="Search" Click="ContentSearchButton_Click"/>
                                <ComboBox x:Name="ContentSortComboBox" Grid.Column="2" SelectedIndex="0" SelectionChanged="ContentFilter_Changed">
                                    <ComboBoxItem Content="Relevance" Tag="relevance"/>
                                    <ComboBoxItem Content="Downloads" Tag="downloads"/>
                                    <ComboBoxItem Content="Newest" Tag="newest"/>
                                    <ComboBoxItem Content="Recently Updated" Tag="updated"/>
                                </ComboBox>
                                <ComboBox x:Name="ContentInstanceComboBox" Grid.Column="3" MinWidth="180" SelectionChanged="ContentFilter_Changed"/>
                            </Grid>
                            <TextBlock x:Name="ContentInfoText" Grid.Row="1" Margin="0,8,0,0" FontSize="12"
                                       Foreground="{ThemeResource FgSecondaryBrush}" TextWrapping="Wrap"/>
                            <ListView x:Name="ContentResultsList" Grid.Row="2" Margin="0,8,0,0" SelectionMode="None"
                                      IsItemClickEnabled="False">
                                <ListView.ItemTemplate>
                                    <DataTemplate x:DataType="local:ContentItemVm">
                                        <Grid Margin="0,6" ColumnSpacing="10">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="48"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <Border Grid.Column="0" Width="48" Height="48" CornerRadius="6" Background="{ThemeResource BgSecondaryBrush}">
                                                <Image Source="{x:Bind Icon, Mode=OneWay}" Stretch="UniformToFill"/>
                                            </Border>
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                <StackPanel Orientation="Horizontal" Spacing="6">
                                                    <TextBlock Text="{x:Bind Title}" FontWeight="Bold" Foreground="{ThemeResource FgPrimaryBrush}"/>
                                                    <TextBlock Text="{x:Bind Author}" FontSize="12" Foreground="{ThemeResource FgSecondaryBrush}" VerticalAlignment="Bottom"/>
                                                </StackPanel>
                                                <TextBlock Text="{x:Bind Description}" FontSize="12" TextTrimming="CharacterEllipsis" MaxLines="2"
                                                           TextWrapping="Wrap" Foreground="{ThemeResource FgSecondaryBrush}"/>
                                                <TextBlock Text="{x:Bind Meta}" FontSize="11" Foreground="{ThemeResource FgSecondaryBrush}"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                                <Button Content="{x:Bind DetailsLabel}" Visibility="{x:Bind DetailsVisibility}"
                                                        Click="ContentDetailsButton_Click" Tag="{x:Bind}"/>
                                                <Button Content="{x:Bind InstallLabel, Mode=OneWay}"
                                                        Click="ContentInstallButton_Click" Tag="{x:Bind}"/>
                                            </StackPanel>
                                        </Grid>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                            <StackPanel Grid.Row="3" Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center" Margin="0,8,0,0">
                                <Button x:Name="ContentPrevButton" Content="Previous" Click="ContentPrevButton_Click" IsEnabled="False"/>
                                <TextBlock x:Name="ContentPageText" Text="Page 1" VerticalAlignment="Center" Foreground="{ThemeResource FgSecondaryBrush}"/>
                                <Button x:Name="ContentNextButton" Content="Next" Click="ContentNextButton_Click" IsEnabled="False"/>
                            </StackPanel>
                        </Grid>
                    </NavigationView>
                </Grid>
                <Grid x:Name="SettingsPanel" Visibility="Collapsed" Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,20">
                        <TextBlock x:Name="SettingsTitleText" Text="Settings" FontSize="20" FontWeight="Bold" VerticalAlignment="Center"
                                   Foreground="{ThemeResource FgPrimaryBrush}"/>
                        <TextBlock x:Name="SettingsSubtitleText" Text="Configure your launcher preferences"
                                   FontSize="12" Foreground="{ThemeResource FgSecondaryBrush}" VerticalAlignment="Center" Margin="15,0,0,0"/>
                    </StackPanel>
                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="200"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <!-- Settings Navigation -->
                        <StackPanel Grid.Column="0" Margin="10">
                            <Button x:Name="GeneralSettingsButton" Content="General" HorizontalAlignment="Stretch" Margin="0,0,0,5"/>
                            <Button x:Name="AccountsSettingsButton" Content="Accounts" HorizontalAlignment="Stretch" Margin="0,0,0,5"/>
                            <Button x:Name="AdvancedSettingsButton" Content="Advanced" HorizontalAlignment="Stretch" Margin="0,0,0,5"/>
                            <Button x:Name="AboutSettingsButton" Content="About" HorizontalAlignment="Stretch"/>
                        </StackPanel>
                        <!-- Settings Content -->
                        <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto">
                            <StackPanel Margin="10">
                                <!-- General Settings -->
                                <StackPanel x:Name="GeneralSettingsPanel" Visibility="Visible">
                                    <TextBlock x:Name="SettingsGeneralTitle" Text="General Settings" FontSize="16" FontWeight="Bold" Margin="0,0,0,15"
                                               Foreground="{ThemeResource FgPrimaryBrush}"/>
                                    <StackPanel Margin="0,0,0,15">
                                        <TextBlock x:Name="SettingsLanguageLabel" Text="Language" FontSize="14" FontWeight="Bold" Foreground="{ThemeResource FgPrimaryBrush}" Margin="0,0,0,10"/>
                                        <TextBlock x:Name="SettingsLanguageDesc" Text="Choose your preferred language for the launcher interface."
                                                   FontSize="12" Foreground="{ThemeResource FgSecondaryBrush}" Margin="0,0,0,10"/>
                                        <ComboBox x:Name="LanguageComboBox" Width="300" HorizontalAlignment="Left">
                                            <ComboBoxItem Content="English (United States)" Tag="en-US"/>
                                            <ComboBoxItem Content="Lietuviu (Lithuania)" Tag="lt-LT"/>
                                            <ComboBoxItem Content="Russkiy (Russia)" Tag="ru-RU"/>
                                            <ComboBoxItem Content="Polski (Poland)" Tag="pl-PL"/>
                                            <ComboBoxItem Content="Deutsch (Germany)" Tag="de-DE"/>
                                            <ComboBoxItem Content="Latviesu (Latvia)" Tag="lv-LV"/>
                                        </ComboBox>
                                        <TextBlock x:Name="SettingsLanguageNote" Text="Note: Changing language requires restarting the application."
                                                   FontSize="11" Foreground="{ThemeResource AccentPrimaryBrush}" Margin="0,10,0,0"/>
                                    </StackPanel>
                                    <StackPanel>
                                        <TextBlock x:Name="SettingsThemeLabel" Text="Theme" FontSize="14" FontWeight="Bold" Foreground="{ThemeResource FgPrimaryBrush}" Margin="0,0,0,10"/>
                                        <TextBlock x:Name="SettingsThemeDesc" Text="Choose your preferred visual theme."
                                                   FontSize="12" Foreground="{ThemeResource FgSecondaryBrush}" Margin="0,0,0,10"/>
                                        <ComboBox x:Name="ThemeComboBox" Width="300" HorizontalAlignment="Left">
                                            <ComboBoxItem Content="Dark Mode" Tag="dark"/>
                                            <ComboBoxItem Content="Light Mode" Tag="light"/>
                                            <ComboBoxItem Content="System Default" Tag="system"/>
                                        </ComboBox>
                                        <TextBlock x:Name="SettingsThemeNote" Text="Theme changes apply immediately."
                                                   FontSize="11" Foreground="{ThemeResource AccentPrimaryBrush}" Margin="0,10,0,0"/>
                                    </StackPanel>
                                    <StackPanel Margin="0,15,0,0">
                                        <TextBlock x:Name="SettingsUiStyleLabel" Text="Interface Style" FontSize="14" FontWeight="Bold" Foreground="{ThemeResource FgPrimaryBrush}" Margin="0,0,0,10"/>
                                        <TextBlock x:Name="SettingsUiStyleDesc" Text="Modern (Windows 11) or Classic (Windows 10) interface. Switching restarts the launcher."
                                                   FontSize="12" Foreground="{ThemeResource FgSecondaryBrush}" Margin="0,0,0,10"/>
                                        <ComboBox x:Name="UiStyleComboBox" Width="300" HorizontalAlignment="Left" SelectionChanged="UiStyleComboBox_SelectionChanged">
                                            <ComboBoxItem Content="Modern (Windows 11 style)" Tag="winui"/>
                                            <ComboBoxItem Content="Classic (Windows 10 style)" Tag="wpf"/>
                                        </ComboBox>
                                    </StackPanel>
                                    <StackPanel Margin="0,15,0,0">
                                        <TextBlock x:Name="SettingsNewsBrowserLabel" Text="News Renderer" FontSize="14" FontWeight="Bold" Foreground="{ThemeResource FgPrimaryBrush}" Margin="0,0,0,10"/>
                                        <TextBlock x:Name="SettingsNewsBrowserDesc" Text="WebView2 shows the full news page; the native renderer works without WebView2."
                                                   FontSize="12" Foreground="{ThemeResource FgSecondaryBrush}" Margin="0,0,0,10"/>
                                        <ComboBox x:Name="NewsBrowserComboBox" Width="300" HorizontalAlignment="Left">
                                            <ComboBoxItem Content="WebView2" Tag="webview2"/>
                                            <ComboBoxItem Content="Native renderer" Tag="native"/>
                                        </ComboBox>
                                    </StackPanel>
                                </StackPanel>

                                <!-- Accounts Settings -->
                                <StackPanel x:Name="AccountsSettingsPanel" Visibility="Collapsed">
                                    <TextBlock x:Name="SettingsAccountsTitle" Text="Account Management" FontSize="16" FontWeight="Bold" Margin="0,0,0,15"
                                               Foreground="{ThemeResource FgPrimaryBrush}"/>
                                    <StackPanel Margin="0,0,0,15">
                                        <TextBlock x:Name="SettingsMcAccountsLabel" Text="Minecraft Accounts" FontSize="14" FontWeight="Bold" Foreground="{ThemeResource FgPrimaryBrush}" Margin="0,0,0,10"/>
                                        <TextBlock x:Name="SettingsMcAccountsDesc" Text="Manage your Minecraft accounts for launching games."
                                                   FontSize="12" Foreground="{ThemeResource FgSecondaryBrush}" Margin="0,0,0,15"/>
                                        <ListView x:Name="AccountsListBox" Height="200" Margin="0,0,0,15" SelectionMode="Single"
                                                       SelectionChanged="AccountsListBox_SelectionChanged">
                                            <ListView.ItemTemplate>
                                                <DataTemplate x:DataType="local:UserProfileDisplay">
                                                    <Grid Padding="4,6" ColumnSpacing="10">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto"/>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>
                                                        <FontIcon Grid.Column="0" Style="{StaticResource IconAccounts}" FontSize="16"
                                                                  VerticalAlignment="Center"/>
                                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                            <TextBlock Text="{x:Bind Username}" FontWeight="SemiBold" FontSize="13"/>
                                                            <TextBlock Text="{x:Bind TypeDisplay}" FontSize="11" Opacity="0.6"/>
                                                        </StackPanel>
                                                        <Button Grid.Column="2" Content="Select" Padding="12,4"
                                                                Click="SelectAccount_Click" Tag="{x:Bind Profile}"/>
                                                        <Button Grid.Column="3" Content="Remove" Padding="12,4"
                                                                Click="RemoveAccount_Click" Tag="{x:Bind Profile}">
                                                            <Button.Foreground>
                                                                <SolidColorBrush Color="#FF5555"/>
                                                            </Button.Foreground>
                                                        </Button>
                                                    </Grid>
                                                </DataTemplate>
                                            </ListView.ItemTemplate>
                                        </ListView>
                                        <StackPanel Orientation="Horizontal" Spacing="10">
                                            <Button x:Name="AddMicrosoftAccountButton" Height="35" MinWidth="180" Padding="15,8">
                                                <StackPanel Orientation="Horizontal">
                                                    <FontIcon Style="{StaticResource IconMicrosoft}" FontSize="14" Margin="0,0,8,0"/>
                                                    <TextBlock x:Name="AddMsAccountBtnText" Text="Add Microsoft Account"/>
                                                </StackPanel>
                                            </Button>
                                            <Button x:Name="AddOfflineAccountButton" Height="35" MinWidth="180" Padding="15,8">
                                                <StackPanel Orientation="Horizontal">
                                                    <FontIcon Style="{StaticResource IconOffline}" FontSize="14" Margin="0,0,8,0"/>
                                                    <TextBlock x:Name="AddOfflineAccountBtnText" Text="Add Offline Account"/>
                                                </StackPanel>
                                            </Button>
                                        </StackPanel>
                                    </StackPanel>
                                    <StackPanel Margin="0,0,0,15">
                                        <TextBlock x:Name="SettingsSkinPreviewLabel" Text="Skin Preview" FontSize="14" FontWeight="Bold" Foreground="{ThemeResource FgPrimaryBrush}" Margin="0,0,0,10"/>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Margin="0,0,20,0" HorizontalAlignment="Center">
                        <!-- Simple Image control for skin preview. We use server-side renders or local composed bitmaps as the source. -->
                        <Image x:Name="SkinFullImage" Width="240" Height="360" Stretch="Uniform" Margin="0,0,0,10" Visibility="Collapsed"/>
                                <olcontrols:SkinViewer3D x:Name="SkinBodyViewer" Width="240" Height="360" Margin="0,0,0,10" ToolTipService.ToolTip="Drag to rotate"/>
                    </StackPanel>
                                            <StackPanel Grid.Column="1">
                                                <TextBlock x:Name="SkinInfoText" Text="Select an account to view skin" FontSize="12"
                                                           Foreground="{ThemeResource FgSecondaryBrush}" TextWrapping="Wrap" Margin="0,0,0,15"/>
                                                <StackPanel Orientation="Horizontal" Spacing="10" Margin="0,0,0,10">
                                                    <Button x:Name="ChangeSkinButton" Height="30" Padding="15,5">
                                                        <StackPanel Orientation="Horizontal">
                                                            <FontIcon Style="{StaticResource IconAdd}" FontSize="14" Margin="0,0,8,0"/>
                                                            <TextBlock x:Name="UploadSkinBtnText" Text="Upload Skin"/>
                                                        </StackPanel>
                                                    </Button>
                                                    <Button x:Name="ResetSkinButton" Height="30" Padding="15,5">
                                                        <StackPanel Orientation="Horizontal">
                                                            <FontIcon Style="{StaticResource IconRefresh}" FontSize="14" Margin="0,0,8,0"/>
                                                            <TextBlock x:Name="ResetSkinBtnText" Text="Reset Skin"/>
                                                        </StackPanel>
                                                    </Button>
                                                </StackPanel>
                                                <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                                    <TextBlock x:Name="SkinModelLabel" Text="Model:" VerticalAlignment="Center" Margin="0,0,10,0" Foreground="{ThemeResource FgPrimaryBrush}"/>
                                                    <RadioButton x:Name="SkinModelSteve" Content="Steve (Classic)" GroupName="SkinModel" IsChecked="True" Margin="0,0,15,0"/>
                                                    <RadioButton x:Name="SkinModelAlex" Content="Alex (Slim)" GroupName="SkinModel"/>
                                                </StackPanel>
                                            </StackPanel>
                                        </Grid>
                                    </StackPanel>
                                </StackPanel>

                                <!-- Advanced Settings -->
                                <StackPanel x:Name="AdvancedSettingsPanel" Visibility="Collapsed">
                                    <TextBlock x:Name="SettingsAdvancedTitle" Text="Advanced Settings" FontSize="16" FontWeight="Bold" Margin="0,0,0,15"
                                               Foreground="{ThemeResource FgPrimaryBrush}"/>
                                    <StackPanel Margin="0,0,0,15">
                                        <TextBlock x:Name="SettingsDiscordTitle" Text="Discord Rich Presence" FontSize="14" FontWeight="Bold" Foreground="{ThemeResource FgPrimaryBrush}" Margin="0,0,0,10"/>
                                        <CheckBox x:Name="DiscordRpcCheckBox" Content="Enable Discord Rich Presence" Margin="0,0,0,10"/>
                                        <TextBlock x:Name="SettingsDiscordDesc" Text="Show your Minecraft activity in Discord."
                                                   FontSize="12" Foreground="{ThemeResource FgSecondaryBrush}"/>
                                    </StackPanel>
                                    <StackPanel Margin="0,0,0,15">
                                        <TextBlock x:Name="SettingsTelemetryTitle" Text="Telemetry" FontSize="14" FontWeight="Bold" Foreground="{ThemeResource FgPrimaryBrush}" Margin="0,0,0,10"/>
                                        <CheckBox x:Name="DeleteTelemetryCheckBox" Content="Delete telemetry files on startup" Margin="0,0,0,10"/>
                                        <TextBlock x:Name="SettingsTelemetryDesc" Text="Automatically clean up Minecraft telemetry data on launcher startup."
                                                   FontSize="12" Foreground="{ThemeResource FgSecondaryBrush}"/>
                                    </StackPanel>
                                    <StackPanel Margin="0,0,0,15">
                                        <TextBlock x:Name="SettingsPluginsTitle" Text="Plugins" FontSize="14" FontWeight="Bold" Foreground="{ThemeResource FgPrimaryBrush}" Margin="0,0,0,10"/>
                                        <TextBlock x:Name="SettingsPluginsDesc" Text="Manage launcher plugins and extensions."
                                                   FontSize="12" Foreground="{ThemeResource FgSecondaryBrush}" Margin="0,0,0,15"/>
                                        <ListView x:Name="PluginsListBox" Height="150" Margin="0,0,0,15" SelectionMode="None"/>
                                        <StackPanel Orientation="Horizontal" Spacing="10">
                                            <Button x:Name="AddPluginButton" Height="35" MinWidth="140" Padding="15,8">
                                                <StackPanel Orientation="Horizontal">
                                                    <FontIcon Style="{StaticResource IconAdd}" FontSize="14" Margin="0,0,8,0"/>
                                                    <TextBlock x:Name="AddPluginBtnText" Text="Add Plugin"/>
                                                </StackPanel>
                                            </Button>
                                            <Button x:Name="RefreshPluginsButton" Height="35" MinWidth="120" Padding="15,8">
                                                <StackPanel Orientation="Horizontal">
                                                    <FontIcon Style="{StaticResource IconRefresh}" FontSize="14" Margin="0,0,8,0"/>
                                                    <TextBlock x:Name="RefreshPluginsBtnText" Text="Refresh"/>
                                                </StackPanel>
                                            </Button>
                                        </StackPanel>
                                    </StackPanel>
                                    <StackPanel Margin="0,0,0,15">
                                        <TextBlock x:Name="SettingsDebugTitle" Text="Debug Mode" FontSize="14" FontWeight="Bold" Foreground="{ThemeResource FgPrimaryBrush}" Margin="0,0,0,10"/>
                                        <CheckBox x:Name="DebugModeCheckBox" Content="Enable debug mode" Margin="0,0,0,10"/>
                                        <TextBlock x:Name="SettingsDebugDesc" Text="Show detailed logging and debugging information."
                                                   FontSize="12" Foreground="{ThemeResource FgSecondaryBrush}" Margin="0,0,0,15"/>
                                        <TextBox x:Name="DebugInfoTextBox" Height="100" IsReadOnly="True"
                                                 FontFamily="Consolas" FontSize="10" Visibility="Collapsed"
                                                 AcceptsReturn="True"/>
                                    </StackPanel>
                                    <StackPanel Margin="0,0,0,15">
                                        <TextBlock x:Name="SettingsGpuTitle" Text="GPU Settings" FontSize="14" FontWeight="Bold" Foreground="{ThemeResource FgPrimaryBrush}" Margin="0,0,0,10"/>
                                        <CheckBox x:Name="UseDiscreteGpuCheckBox" Content="Force use discrete GPU (NVIDIA/AMD)" Margin="0,0,0,10"/>
                                        <TextBlock x:Name="SettingsGpuDesc" Text="Forces Minecraft to use your dedicated graphics card instead of integrated graphics."
                                                   FontSize="12" Foreground="{ThemeResource FgSecondaryBrush}" TextWrapping="Wrap"/>
                                    </StackPanel>
                                    <StackPanel Margin="0,0,0,15">
                                        <TextBlock x:Name="JavaManagementTitle" Text="Java Management" FontSize="14" FontWeight="Bold" Foreground="{ThemeResource FgPrimaryBrush}" Margin="0,0,0,10"/>
                                        <TextBlock x:Name="JavaManagementDesc" Text="Install and manage Java runtimes used by the launcher."
                                                   FontSize="12" Foreground="{ThemeResource FgSecondaryBrush}" Margin="0,0,0,15"/>
                                        <ListView x:Name="JavaListBox" Height="180" Margin="0,0,0,10" SelectionMode="None">
                                            <ListView.ItemTemplate>
                                                <DataTemplate x:DataType="local:JavaListItem">
                                                    <Grid Padding="4,6" ColumnSpacing="10">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>
                                                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                                            <TextBlock Text="{x:Bind DisplayName}" FontWeight="SemiBold" FontSize="13"/>
                                                            <TextBlock Text="{x:Bind StatusText}" FontSize="11" Opacity="0.6"/>
                                                        </StackPanel>
                                                        <Button Grid.Column="1" Content="{x:Bind InstallButtonText}" Padding="12,4"
                                                                Click="JavaInstallButton_Click" Tag="{x:Bind MajorVersion}"
                                                                IsEnabled="{x:Bind CanInstall}"/>
                                                        <Button Grid.Column="2" Content="Uninstall" Padding="12,4"
                                                                Click="JavaUninstallButton_Click" Tag="{x:Bind MajorVersion}"
                                                                IsEnabled="{x:Bind IsInstalled}">
                                                            <Button.Foreground>
                                                                <SolidColorBrush Color="#FF5555"/>
                                                            </Button.Foreground>
                                                        </Button>
                                                    </Grid>
                                                </DataTemplate>
                                            </ListView.ItemTemplate>
                                        </ListView>
                                        <Button x:Name="RefreshJavaButton" Click="RefreshJavaButton_Click" Padding="10,5">
                                            <StackPanel Orientation="Horizontal">
                                                <FontIcon Style="{StaticResource IconRefresh}" FontSize="14" Margin="0,0,8,0"/>
                                                <TextBlock x:Name="RefreshJavaBtnText" Text="Refresh"/>
                                            </StackPanel>
                                        </Button>
                                        <ProgressBar x:Name="JavaProgressBar" Height="4" Margin="0,10,0,0"
                                                     IsIndeterminate="False" Visibility="Collapsed"/>
                                        <TextBlock x:Name="JavaProgressText" Text="" FontSize="11"
                                                   Foreground="{ThemeResource FgTertiaryBrush}" Margin="0,5,0,0"/>
                                    </StackPanel>
                                </StackPanel>
                                <StackPanel x:Name="AboutSettingsPanel" Visibility="Collapsed">
                                    <StackPanel HorizontalAlignment="Center" Margin="0,20,0,0">
                                        <Image Source="ms-appx:///Other/images/orange.png" Width="64" Height="64" HorizontalAlignment="Center" Margin="0,0,0,15"/>
                                        <TextBlock Text="OrangLauncher" FontSize="18" FontWeight="Bold" Margin="0,0,0,10"
                                                   Foreground="{ThemeResource FgPrimaryBrush}" HorizontalAlignment="Center"/>
                                        <TextBlock x:Name="AboutVersionText" Text="Version: 5.0.0" FontSize="12" Margin="0,0,0,5"
                                                   Foreground="{ThemeResource FgPrimaryBrush}" HorizontalAlignment="Center"/>
                                        <TextBlock x:Name="AboutDescText" Text="A modern Legacy Minecraft launcher with advanced features."
                                                   FontSize="12" Foreground="{ThemeResource FgSecondaryBrush}" Margin="0,0,0,20"
                                                   TextWrapping="Wrap" HorizontalAlignment="Center" TextAlignment="Center"/>
                                        <TextBlock x:Name="AboutDevsText" Text="Developed by: adasjusk and previously vakarux"
                                                   FontSize="12" Margin="0,0,0,15" Foreground="{ThemeResource FgPrimaryBrush}" HorizontalAlignment="Center"/>
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="10">
                                            <Button x:Name="CheckUpdatesButton" Height="35" MinWidth="160" Padding="15,8">
                                                <StackPanel Orientation="Horizontal">
                                                    <FontIcon Style="{StaticResource IconUpdate}" FontSize="14" Margin="0,0,8,0"/>
                                                    <TextBlock x:Name="CheckUpdatesBtnText" Text="Check for Updates"/>
                                                </StackPanel>
                                            </Button>
                                            <Button x:Name="OpenGitHubButton" Height="35" MinWidth="160" Padding="15,8">
                                                <StackPanel Orientation="Horizontal">
                                                    <FontIcon Style="{StaticResource IconGithub}" FontSize="14" Margin="0,0,8,0"/>
                                                    <TextBlock x:Name="ViewGitHubBtnText" Text="View on GitHub"/>
                                                </StackPanel>
                                            </Button>
                                        </StackPanel>
                                    </StackPanel>
                                </StackPanel>
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>
                </Grid>
            </Grid>
        </NavigationView>

        <!-- Bottom Bar -->
        <Border Grid.Row="1" BorderBrush="{ThemeResource AppBorderBrush}" BorderThickness="0,1,0,0"
                Background="{ThemeResource BgSecondaryBrush}">
            <Grid Margin="10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Orientation="Vertical" VerticalAlignment="Center">
                    <TextBlock x:Name="FooterProfileLabel" Text="PROFILE" FontWeight="Bold" Foreground="{ThemeResource FgPrimaryBrush}"/>
                    <ComboBox x:Name="ProfileComboBox" Width="200" Margin="0,5,0,0">
                        <ComboBoxItem Content="Loading profiles..."/>
                    </ComboBox>
                    <Button x:Name="ManageAccountsButton" Content="Manage Accounts" Margin="0,5,0,0"
                            Padding="10,5" Click="ManageAccountsButton_Click"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Vertical" HorizontalAlignment="Center"
                            VerticalAlignment="Center">
                    <TextBlock x:Name="FooterGameProfilesLabel" Text="GAME PROFILES" FontWeight="Bold" HorizontalAlignment="Center"
                               Foreground="{ThemeResource FgPrimaryBrush}"/>
                    <TextBlock x:Name="GameProfileInfoLabel" Text="No profile selected"
                               HorizontalAlignment="Center" Margin="0,5,0,10"
                               Foreground="{ThemeResource FgSecondaryBrush}"/>
                    <Button x:Name="PlayButton" Content="PLAY"
                            HorizontalAlignment="Center" Height="56" Width="217"
                            Click="PlayButton_Click"
                            Background="{ThemeResource PlayButtonBgBrush}"
                            Foreground="{ThemeResource PlayButtonFgBrush}"
                            FontSize="18" FontWeight="Bold"/>
                </StackPanel>
                <StackPanel Grid.Column="2" Orientation="Vertical" VerticalAlignment="Center"
                            HorizontalAlignment="Right">
                    <ComboBox x:Name="GameProfileComboBox" Width="250" Margin="0,0,0,5">
                        <ComboBoxItem Content="Loading game profiles..."/>
                    </ComboBox>
                    <TextBlock x:Name="StatusLabel" Text="Welcome" HorizontalAlignment="Right"
                               Foreground="{ThemeResource FgSecondaryBrush}"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>

