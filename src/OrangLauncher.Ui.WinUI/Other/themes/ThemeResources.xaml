    </ResourceDictionary.ThemeDictionaries>
    <x:Double x:Key="GlobalButtonHeight">30</x:Double>
    <x:Double x:Key="GlobalButtonWidth">150</x:Double>
    <x:Double x:Key="GlobalButtonIconSize">16</x:Double>
    <x:Double x:Key="GlobalButtonFontSize">12</x:Double>
    <x:Double x:Key="GlobalTabFontSize">12</x:Double>

