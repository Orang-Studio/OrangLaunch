  <Fragment>
    <StandardDirectory Id="DesktopFolder">
      <Component Id="CmpDesktopShortcut" Guid="*">
        <Shortcut
          Id="DesktopShortcut"
          Name="OrangLauncher"
          Description="OrangLauncher — Minecraft Launcher"
          Target="[INSTALLFOLDER]OrangLauncher.exe"
          WorkingDirectory="INSTALLFOLDER"
          Icon="OrangLauncherIcon.ico"
          IconIndex="0" />
        <RegistryValue
          Root="HKCU"
          Key="Software\OrangLauncher"
          Name="DesktopShortcut"
          Type="integer"
          Value="1"
          KeyPath="yes" />
      </Component>
    </StandardDirectory>
  </Fragment>
  <Fragment>
    <DirectoryRef Id="OrangStartMenuFolder">
      <Component Id="CmpStartMenuShortcut" Guid="*">
        <Shortcut
          Id="StartMenuShortcut"
          Name="OrangLauncher"
          Description="OrangLauncher — Minecraft Launcher"
          Target="[INSTALLFOLDER]OrangLauncher.exe"
          WorkingDirectory="INSTALLFOLDER"
          Icon="OrangLauncherIcon.ico"
          IconIndex="0" />
        <RemoveFolder
          Id="RemoveOrangStartMenuFolder"
          Directory="OrangStartMenuFolder"
          On="uninstall" />
        <RegistryValue
          Root="HKCU"
          Key="Software\OrangLauncher"
          Name="StartMenuShortcut"
          Type="integer"
          Value="1"
          KeyPath="yes" />
      </Component>
    </DirectoryRef>
  </Fragment>
  <Fragment>
    <Component Id="CmpWebView2DirPermissions" Directory="WEBVIEW2DIR" Guid="7B3E9F2A-4C1D-4A8E-B6F5-0D2E8A3C7F91">
      <CreateFolder>
        <util:PermissionEx User="Users" GenericAll="yes" />
      </CreateFolder>
    </Component>
  </Fragment>
